","h2",null,{"style":{"fontSize":14,"fontWeight":400,"lineHeight":"49px","margin":0},"children":"This page could not be found."}]}]]}]}]],[]],"forbidden":"$undefined","unauthorized":"$undefined"}]}]}]}]]}],{"children":[["$","$1","c",{"children":[null,["$","$L3",null,{"parallelRouterKey":"children","error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L4",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","forbidden":"$undefined","unauthorized":"$undefined"}]]}],{"children":[["$","$1","c",{"children":[["$","main",null,{"className":"min-h-screen bg-black pb-32","children":["$","div",null,{"className":"mx-auto w-full max-w-[1600px] px-6 py-24 md:px-12 xl:px-40","children":[["$","div",null,{"className":"border-b border-[#EAEAEA]/10 pb-12","children":[["$","p",null,{"className":"text-xs uppercase tracking-[0.2em] text-[#EAEAEA]/50","children":"AEO pipeline · melk.no"}],["$","h1",null,{"className":"mt-4 text-4xl leading-tight tracking-tight text-[#EAEAEA] md:text-6xl","children":"Oppskrifts-AEO"}],["$","p",null,{"className":"mt-5 max-w-3xl text-base leading-relaxed text-[#B0B0B0] md:text-lg","children":[50," oppskrifter er konvertert til strukturerte AEO-innholdsblokker med"," ",["$","span",null,{"className":"text-[#EAEAEA]","children":[201," FAQ-spørsmål"]}],", primærsvar og mikrosvar klare for implementering."]}],["$","div",null,{"className":"mt-6 flex flex-wrap gap-6","children":[["$","a",null,{"href":"/data/aeo_output.json","download":true,"className":"inline-flex items-center gap-2 text-sm text-[#EAEAEA]/60 underline underline-offset-4 transition-colors hover:text-[#EAEAEA]","children":"↓ Last ned JSON"}],["$","a",null,{"href":"/data/aeo_output.csv","download":true,"className":"inline-flex items-center gap-2 text-sm text-[#EAEAEA]/60 underline underline-offset-4 transition-colors hover:text-[#EAEAEA]","children":"↓ Last ned CSV"}],["$","a",null,{"href":"/data/aeo_output.html","target":"_blank","rel":"noopener noreferrer","className":"inline-flex items-center gap-2 text-sm text-[#EAEAEA]/60 underline underline-offset-4 transition-colors hover:text-[#EAEAEA]","children":"↗ Vis HTML-rapport"}]]}]]}],["$","$L5",null,{"recipes":[{"recipe":"Boller (grunnoppskrift)","primary_answer":"Smelt smøret og bland det med melk til det blir fingervarmt. Elt inn hvetemel og bakepulver til deigen er smidig, og la den heve. Form boller, pensle med egg, og ovnsbak dem ved 200 °C i 12-15 minutter.","faqs":[{"question":"Hvordan bør bollene oppbevares etter tilberedning?","answer":"Etter at bollene er avkjølt på rist, bør de oppbevares i en lufttett beholder for å bevare fuktigheten fra smøret og melken, slik at de holder seg myke.","type":"storage","score":5},{"question":"Hvordan kan jeg gjøre bolleoppskriften litt sunnere uten å miste karakteren sin?","answer":"Bytt ut halvparten av hvetemelet med fullkornsmel for mer fiber, og bruk lettmelk i stedet for helmelk for å redusere fettinnholdet. Du kan også redusere sukkermengden litt uten å påvirke smaken for mye.","type":"health","score":5},{"question":"Kan jeg bytte ut helmelk eller lettmelk med en plantebasert melk i denne bolleoppskriften?","answer":"Ja, du kan bruke plantebasert melk som mandelmelk eller soyamelk, men vær oppmerksom på at smaken og konsistensen kan bli litt annerledes. Sørg for at melkeblandingen fortsatt blir fingervarm (37 °C) før du blander den med gjæren.","type":"substitution","score":4},{"question":"Er det melk i denne bolleoppskriften?","answer":"Ja, oppskriften inneholder helmelk eller lettmelk som en av ingrediensene.","type":"allergy","score":4},{"question":"Hvorfor blir bollene mine tørre etter steking?","answer":"Bollene kan bli tørre hvis de stekes for lenge. Pass på å følge steketiden nøye og sjekk at de er gyldne etter 12-15 minutter i ovnen.","type":"technique","score":5}],"micro_answers":["Oppbevaring: Oppbevar boller i lufttett beholder for friskhet.","Tilberedningsmetode: Boller er ovnsbakt ved 200 °C.","Ingrediens: 600 g hvetemel brukes i bolledeigen."],"metadata":{"ingredients":["100 g smør","3.5 dl helmelkeller lettmelk","50 g gjær","100 g sukker","0.5 ts salt","1 ts malt kardemomme","1 ts bakepulver","600 g hvetemel","1 stk egg(til pensling)"],"category":"Bakst","cooking_method":"ovnsbakt","allergens":["melk","egg","gluten"],"signals":{"has_milk":true,"has_egg":false,"is_fried":false,"is_baked":true,"is_sweet":true}}},{"recipe":"Boller med appelsinmarmelade","primary_answer":"For å lage boller med appelsinmarmelade, smør appelsinmarmelade på en utkjevlet deigleiv, rull sammen, og skjær i skiver. Legg bollene på en bakepapirkledd stekeplate og ovnsbak dem ved 250 °C i 8-10 minutter.","faqs":[{"question":"Hvordan bør bollene med appelsinmarmelade oppbevares etter tilberedning?","answer":"Oppbevar bollene i en lufttett boks ved romtemperatur for å bevare fuktigheten fra appelsinmarmeladen, eller frys dem ned for lengre holdbarhet.","type":"storage","score":5},{"question":"Hvordan kan jeg gjøre oppskriften på boller med appelsinmarmelade litt sunnere uten å miste karakteren sin?","answer":"Bytt ut halvparten av hvetemelet med fullkornsmel for mer fiber, og reduser sukkeret til 2 ss for mindre sukkerinnhold uten å miste sødmen fra appelsinmarmeladen.","type":"health","score":5},{"question":"Kan jeg bytte ut eggene i denne oppskriften?","answer":"Ja, du kan erstatte eggene med 1/4 kopp eplemos per egg for å beholde fuktigheten i deigen.","type":"substitution","score":4},{"question":"Inneholder denne oppskriften gluten?","answer":"Ja, oppskriften inneholder hvetemel som er en kilde til gluten.","type":"allergy","score":4},{"question":"Hvorfor hever ikke bollene mine ordentlig?","answer":"Sørg for at melken er lunken når du blander den med gjæren, og at deigen får heve på et lunt sted til dobbel størrelse. Kald melk eller et kjølig rom kan hindre gjæringen.","type":"technique","score":4}],"micro_answers":["Oppbevaring: Avkjøl boller på rist før lagring.","Allergener: Inneholder melk, egg og gluten.","Tilberedningsmetode: Ovnsbakt ved 250 °C i 8-10 minutter.","Ingrediens: 1 dl appelsinmarmelade for smak."],"metadata":{"ingredients":["50 g gjær","100 g smør","2 dl lettmelk","1 ts salt","3 ss sukker","1 ts malt kardemomme","420 g hvetemel","1 dl appelsinmarmelade","2 stk egg"],"category":"Bakst","cooking_method":"ovnsbakt","allergens":["melk","egg","gluten"],"signals":{"has_milk":true,"has_egg":true,"is_fried":false,"is_baked":true,"is_sweet":true}}},{"recipe":"Sjokolademousse","primary_answer":"Hakk mørk sjokolade og smelt den sammen med varm melk og smør. Pisk eggehviter og vend dem inn i sjokoladeblandingen, før du setter moussen i kjøleskapet. Grovhakk nøtter og stek dem i en panne med varm olje før servering.","faqs":[{"question":"Hvordan bør sjokolademoussen oppbevares etter tilberedning?","answer":"Oppbevar sjokolademoussen i kjøleskapet i en lufttett beholder for å bevare konsistensen og smaken. Den bør serveres kald, og kan oppbevares i opptil 2 dager.","type":"storage","score":5},{"question":"Hvordan kan jeg gjøre sjokolademoussen litt sunnere uten å miste karakteren sin?","answer":"Du kan redusere mengden sukker og melis, og bruke en mørkere sjokolade med høyere kakaoinnhold for å beholde den rike smaken. Bytt ut kremfløten med en lettere fløtevariant for å redusere fettinnholdet.","type":"health","score":5},{"question":"Kan jeg bytte ut melken i denne sjokolademousse-oppskriften?","answer":"Ja, du kan bytte ut melken med en plantebasert melk som mandelmelk eller havremelk, men det kan påvirke smaken litt.","type":"substitution","score":5},{"question":"Er det melk i denne sjokolademousseoppskriften?","answer":"Ja, oppskriften inneholder 1 dl melk som en del av sjokoladeblandingen.","type":"allergy","score":4},{"question":"Hvorfor blir ikke sjokolademoussen min luftig?","answer":"Pass på at eggehvitene er pisket til de er helt stive før de vendes inn i sjokoladeblandingen. Dette gir moussen den nødvendige luften og lettheten.","type":"technique","score":4}],"micro_answers":["Oppbevaring: Sett sjokolademoussen i kjøleskap i minst 40 minutter.","Allergener: Inneholder melk, egg, gluten og nøtter.","Tilberedningsmetode: Ovnsbakt sjokolademousse.","Ingrediens: 200 g mørk sjokolade, 70% kakao.","Tilberedning: Pisk eggehvitene luftig og vend inn i blandingen."],"metadata":{"ingredients":["200 g mørk sjokolade, 70% kakao","1 dl melk","50 g meierismør","2 stk eggeplomme","1 ss sukker","2 stk eggehvite","2 dl kremfløte","100 g mandler","100 g valnøttkjerner","100 g hasselnøtter","100 g melis","1 dl solsikkeolje"],"category":"Desserter","cooking_method":"ovnsbakt","allergens":["melk","egg","gluten","nøtter"],"signals":{"has_milk":true,"has_egg":true,"is_fried":true,"is_baked":true,"is_sweet":true}}},{"recipe":"Cottage cheese bar","primary_answer":"Bland cottage cheese, smør og honning til en glatt konsistens, og form små barer på et brett. Smelt mørk sjokolade og hell over de kalde barene før de settes i kjøleskapet til sjokoladen har stivnet.","faqs":[{"question":"Hvordan bør cottage cheese barene oppbevares etter tilberedning?","answer":"Cottage cheese barene bør oppbevares kaldt i kjøleskapet for å sikre at sjokoladen holder seg stiv og barene beholder sin konsistens.","type":"storage","score":5},{"question":"Hvordan kan jeg gjøre cottage cheese barene litt sunnere uten å miste karakteren sin?","answer":"Bytt ut smøret med kokosolje for en sunnere fettkilde, og bruk mørk sjokolade med høyere kakaoinnhold for å redusere sukkerinnholdet.","type":"health","score":5},{"question":"Kan jeg bytte ut cottage cheese i denne oppskriften?","answer":"Du kan prøve å bytte ut cottage cheese med ricotta for en lignende konsistens, men smaken vil bli litt annerledes. Pass på at du fortsatt får en glatt konsistens når du blander med smør og honning.","type":"substitution","score":5},{"question":"Er det melk i denne cottage cheese bar-oppskriften?","answer":"Ja, oppskriften inneholder cottage cheese og smør, som begge er melkeprodukter.","type":"allergy","score":4},{"question":"Hvorfor smelter ikke sjokoladen jevnt når jeg dekker cottage cheese barene?","answer":"Pass på at sjokoladen smeltes sakte over vannbad for å unngå at den blir for varm, og rør jevnlig for å sikre en glatt konsistens.","type":"technique","score":4}],"micro_answers":["Tilberedningsmetode: ovnsbakt.","Ingrediens: 1 beger Cottage cheese.","Smelt sjokolade over vannbad."],"metadata":{"ingredients":["1 beger cottage cheese","30 g smør","1 ss honning","150 g mørk sjokolade, 70% kakao"],"category":"Desserter","cooking_method":"ovnsbakt","allergens":["melk"],"signals":{"has_milk":true,"has_egg":false,"is_fried":false,"is_baked":true,"is_sweet":true}}},{"recipe":"Granola med syrnet melk","primary_answer":"Bland havregryn, frokostblanding, hvetekli, solsikkekjerner og hakkede hasselnøtter i en langpanne. Drypp over honning og ovnsbak blandingen ved 225 °C i 10 minutter, rør om av og til. Avkjøl før servering med syrnet melk.","faqs":[{"question":"Hvordan kan jeg gjøre granola med syrnet melk litt sunnere uten å miste karakteren sin?","answer":"Bytt ut honning med en mindre mengde lønnesirup for å redusere sukkerinnholdet, og bruk usøtet tørket frukt i stedet for rosiner for å beholde sødmen.","type":"health","score":5},{"question":"Kan jeg bytte ut melk i denne granolaoppskriften?","answer":"Ja, du kan bytte ut melk med plantebaserte alternativer som mandelmelk eller havremelk, men det kan påvirke smaken noe. Sørg for at den valgte melken passer til smaken av granolaen.","type":"substitution","score":5},{"question":"Er det melk i denne granolaoppskriften?","answer":"Ja, oppskriften inneholder både melk og syrnet melk som serveringsforslag.","type":"allergy","score":4},{"question":"Hvorfor blir granolaen min brent i ovnen?","answer":"Sørg for å røre om i blandingen av havregryn, frokostblanding, kli, solsikkekjerner og nøtter jevnlig mens den ristes i ovnen ved 225 °C. Dette forhindrer at honningen brenner seg fast og gir en jevn steking.","type":"technique","score":5}],"micro_answers":["Oppbevaring: Tett boks eller glass.","Allergener: Melk, gluten, nøtter.","Tilberedningsmetode: Ovnsbakt ved 225 °C.","Ingrediens: 2.5 dl Havregryn.","Serveres med: Melk eller syrnet melk."],"metadata":{"ingredients":["2.5 dl havregryn","2 dl frokostblanding (4-korn)","3 ss hvetekli","1 dl solsikkekjerner","1 dl hasselnøtter, hakket","2 ss honning","1 dl rosiner","3 ss bringebær/jordbær","6 dl melk","6 dl syrnet melk"],"category":null,"cooking_method":"ovnsbakt","allergens":["melk","gluten","nøtter"],"signals":{"has_milk":true,"has_egg":false,"is_fried":true,"is_baked":true,"is_sweet":true}}},{"recipe":"Frokostblanding","primary_answer":"Bland havregryn, frokostblanding, frø og valnøttkjerner i en bolle, og rør inn en blanding av vann og honning. Fordel blandingen på en bakepapirkledd langpanne og ovnsbak den ved 180 °C i ca. 20 minutter, mens du rører av og til.","faqs":[{"question":"Hvordan bør frokostblandingen oppbevares etter tilberedning?","answer":"Etter at granolaen er avkjølt, bør den oppbevares i en tett boks for å bevare sprøheten og unngå at rosiner og nøtter blir myke.","type":"storage","score":5},{"question":"Hvordan kan jeg gjøre frokostblandingen litt sunnere uten å miste karakteren sin?","answer":"Du kan redusere mengden honning til 2 ss og tilsette litt mer vann for å opprettholde fuktigheten. Dette vil redusere sukkerinnholdet uten å påvirke smaken for mye.","type":"health","score":5},{"question":"Er det nøtter i denne granolaoppskriften?","answer":"Ja, oppskriften inneholder 30 g valnøttkjerner, så den er ikke egnet for de med nøtteallergi.","type":"allergy","score":4},{"question":"Hvorfor blir granolaen min ikke sprø etter steking?","answer":"Sørg for å røre i blandingen av og til under stekingen for jevn varmefordeling, og la granolaen avkjøles helt før du tilsetter rosiner og kanel. Dette hjelper med å oppnå en sprø tekstur.","type":"technique","score":5}],"micro_answers":["Oppbevaring: Tett boks etter avkjøling.","Tilberedningsmetode: Ovnsbakt ved 180 °C.","Ingrediens: 2.5 dl Havregryn.","Steketid: Ca. 20 minutter."],"metadata":{"ingredients":["2.5 dl havregryn","3 dl frokostblanding (4-korn)","0.5 dl solsikkekjerner","0.5 dl linfrø","0.5 dl sesamfrø","30 g valnøttkjerner","4 ss honning","3 ss vann","1 dl rosiner","0.5 ss malt kanel"],"category":"Granola","cooking_method":"ovnsbakt","allergens":["melk","gluten","nøtter"],"signals":{"has_milk":false,"has_egg":false,"is_fried":true,"is_baked":true,"is_sweet":true}}},{"recipe":"Fiskegrateng","primary_answer":"Kok makaroni og lag en hvit saus ved å smelte smør, røre inn hvetemel og spe med melk. Bland sausen med torskebiter, makaroni og egg, hell i en smurt form, dryss over strøkavring, og ovnsbak i 40 minutter ved 180 °C. Strø revet ost på toppen de siste 15 minuttene av steketiden.","faqs":[{"question":"Hvordan bør fiskegratengen oppbevares etter tilberedning?","answer":"Etter tilberedning bør fiskegratengen avkjøles helt og deretter oppbevares i en lufttett beholder i kjøleskapet. Den kan holde seg i 2-3 dager på grunn av ingredienser som torskefilet og egg.","type":"storage","score":5},{"question":"Hvordan kan jeg gjøre fiskegratengen litt sunnere uten å miste karakteren sin?","answer":"Bytt ut smør med olivenolje for en sunnere fettkilde, og bruk fullkornsmakaroni i stedet for vanlig makaroni for å øke fiberinnholdet.","type":"health","score":5},{"question":"Kan jeg bytte ut melk eller egg i denne fiskegratengoppskriften?","answer":"Du kan erstatte lettmelk med en plantebasert melk som havremelk for en laktosefri variant. Eggene kan byttes ut med linfrøgelé (1 ss malte linfrø blandet med 2,5 ss vann per egg) for en vegansk versjon.","type":"substitution","score":5},{"question":"Inneholder denne fiskegratengen melk, egg eller gluten?","answer":"Ja, fiskegratengen inneholder melk (lettmelk og gulost), egg og gluten (hvetemel og makaroni).","type":"allergy","score":4},{"question":"Hvorfor blir fiskegratengen min for tørr etter steking?","answer":"Sørg for å ikke overkoke sausen og bruk riktig mengde melk for å holde gratengen saftig. Pass også på at fisken ikke er for tørr før du blander den inn.","type":"technique","score":5}],"micro_answers":["Oppbevaring: Fiskegrateng kan fryses for lengre holdbarhet.","Allergener: Inneholder melk, egg og gluten.","Tilberedningsmetode: Ovnsbakt ved 180 °C i 40 minutter.","Ingrediens: 500 g torskefilet brukes i fiskegratengen.","Tilberedning: Kok makaroni etter anvisningen på pakken."],"metadata":{"ingredients":["100 g makaroni","2 ss smør","2 ss hvetemel","4 dl lettmelk","0.5 ts salt","0.5 ts revet muskatnøtt","500 g torskefilet","3 stk egg","1 dl strøkavring","150 g gulost"],"category":"Gratenger","cooking_method":"ovnsbakt","allergens":["melk","egg","gluten"],"signals":{"has_milk":true,"has_egg":true,"is_fried":false,"is_baked":true,"is_sweet":false}}},{"recipe":"Fiskegrateng med laks","primary_answer":"Skjær ørretfileten i små terninger og bland med revet gulrot og purre. Lag en saus av smør, hvetemel og melk, og tilsett grønnsakene. Hell blandingen i en ildfast form, strø over griljermel og ost, og ovnsbak ved 200 °C i ca. 30 minutter.","faqs":[{"question":"Hvordan kan jeg redusere fettinnholdet i fiskegratengen uten å miste smaken?","answer":"Bytt ut smøret med en mindre mengde olivenolje og bruk lett gulost i stedet for vanlig gulost for å redusere fettinnholdet uten å miste smaken.","type":"health","score":5},{"question":"Kan jeg bruke en annen type melk i fiskegratengen med laks?","answer":"Ja, du kan bytte ut lettmelk med havremelk eller soyamelk for en laktosefri variant, men det kan påvirke smaken og konsistensen litt.","type":"substitution","score":5},{"question":"Er det mulig å lage denne fiskegratengen uten melk?","answer":"Ja, du kan erstatte lettmelken med en melkefri alternativ som havremelk, men vær oppmerksom på at smaken kan endres noe.","type":"allergy","score":4},{"question":"Hvorfor blir fiskegratengen min ikke gyllen på toppen etter steking?","answer":"Sørg for å strø griljermel og resten av osten jevnt over gratengen før steking. Dette gir en gyllen og sprø overflate når den stekes ved 200 °C i ca. 30 minutter.","type":"technique","score":5}],"micro_answers":["Oppbevaring: Kjøleskap, maks 2 dager.","Allergener: Inneholder melk, egg, gluten.","Tilberedningsmetode: Ovnsbakt ved 200 °C i 30 minutter.","Ingrediens: 400 g Ørretfilet.","Tilberedning: Smelt smør, rør inn mel og melk."],"metadata":{"ingredients":["400 g ørretfilet","1 stk gulrot","1 stk purre","40 g smør","40 g hvetemel","4 dl lettmelk","1 krm revet muskatnøtt","0.5 stk sitron","100 g gulost","2 stk egg","3 ss griljermel"],"category":"Gratenger","cooking_method":"ovnsbakt","allergens":["melk","egg","gluten"],"signals":{"has_milk":true,"has_egg":true,"is_fried":false,"is_baked":true,"is_sweet":false}}},{"recipe":"Frokostgrøt","primary_answer":"Ha havremel og linfrø i en kasserolle, tilsett lettmelk og kok opp under omrøring. La grøten småkoke i 5 minutter før du smaker til med salt.","faqs":[{"question":"Hvordan kan jeg gjøre frokostgrøten sunnere uten å miste smaken?","answer":"Bytt lettmelk med usøtet mandelmelk for å redusere fettinnholdet, og tilsett en håndfull bær for ekstra vitaminer og naturlig sødme.","type":"health","score":5},{"question":"Kan jeg bytte ut lettmelk med en annen type melk i frokostgrøten?","answer":"Ja, du kan bytte ut lettmelk med mandelmelk eller soyamelk for en laktosefri variant, men det kan påvirke smaken og konsistensen litt.","type":"substitution","score":5},{"question":"Inneholder frokostgrøten melk?","answer":"Ja, frokostgrøten inneholder lettmelk som en av hovedingrediensene.","type":"allergy","score":4}],"micro_answers":["Oppbevaring: Kjøleskap, maks 3 dager.","Tilberedningsmetode: Kokt på komfyren.","Ingrediens: 2.5 dl Havremel."],"metadata":{"ingredients":["2.5 dl havremel","2 ss linfrø","1 l lettmelk (0,5 % fett)","0.5 ts salt"],"category":"Groeter","cooking_method":"kokt","allergens":["melk","gluten"],"signals":{"has_milk":true,"has_egg":false,"is_fried":false,"is_baked":false,"is_sweet":false}}},{"recipe":"Bakt havregrøt med bær og mørk sjokolade","primary_answer":"Mos bananen og bland den med havregryn, bakepulver, melk og egg i en ildfast form. Rør inn bringebær, blåbær og hakket mørk sjokolade, og stek blandingen ovnsbakt i cirka 20 minutter ved 175 °C.","faqs":[{"question":"Hvordan bør bakt havregrøt med bær og mørk sjokolade oppbevares etter tilberedning?","answer":"Etter tilberedning bør den bakte havregrøten avkjøles helt og deretter oppbevares i en lufttett beholder i kjøleskapet. Den kan holde seg i opptil 3 dager.","type":"storage","score":5},{"question":"Hvordan kan jeg gjøre bakt havregrøt med bær og mørk sjokolade litt sunnere uten å miste karakteren sin?","answer":"Bytt ut halvparten av melken med mandelmelk for å redusere kaloriinnholdet, og bruk 85% mørk sjokolade for å øke antioksidantnivået uten å miste smaken.","type":"health","score":5},{"question":"Kan jeg erstatte melk med en plantebasert melk i denne oppskriften?","answer":"Ja, du kan bruke mandelmelk eller havremelk som erstatning for melk. Dette vil ikke påvirke tilberedningsmetoden.","type":"substitution","score":5},{"question":"Er det mulig å lage denne oppskriften uten melk?","answer":"Ja, du kan erstatte melk med en plantebasert melk som mandel- eller havremelk for å unngå melk i oppskriften.","type":"allergy","score":4},{"question":"Hvorfor blir ikke den bakte havregrøten fast nok etter steking?","answer":"Sørg for at du har brukt riktig mengde havregryn og egg, da disse gir struktur. Hvis grøten fortsatt er for løs, kan du prøve å steke den litt lenger eller justere mengden melk.","type":"technique","score":5}],"micro_answers":["Oppbevaring: Oppbevar i kjøleskap i opptil 3 dager.","Allergener: Inneholder melk, egg og gluten.","Tilberedningsmetode: Ovnsbakt ved 175 °C i 20 minutter.","Ingrediens: Mørk sjokolade med 70% kakao."],"metadata":{"ingredients":["1 dl banan","3 dl havregryn","1 ts bakepulver","3 dl melk","1 egg","100 g bringebær","100 g blåbær","50 g mørk sjokolade, 70% kakao"],"category":"Groeter","cooking_method":"ovnsbakt","allergens":["melk","egg","gluten"],"signals":{"has_milk":true,"has_egg":true,"is_fried":false,"is_baked":true,"is_sweet":true}}},{"recipe":"Fiskegryte","primary_answer":"Smelt smør i en gryte og tilsett karri, purre, løk og hvitløk. Rør inn hvetemel, tilsett melk og crème fraîche, og gi det et raskt oppkok før det småkoker. Legg torskebitene og paprika i gryten og la det trekke i ca 10 minutter til fisken er ferdig kokt.","faqs":[{"question":"Kan jeg erstatte lettmelk med en annen type melk i fiskegryten?","answer":"Ja, du kan erstatte lettmelk med helmelk eller en plantebasert melk som havremelk, men det kan påvirke smaken og konsistensen litt. Sørg for å røre godt for å unngå klumper når du tilsetter melken.","type":"substitution","score":5},{"question":"Inneholder fiskegryten melk?","answer":"Ja, fiskegryten inneholder både lettmelk og crème fraîche som er melkeprodukter.","type":"allergy","score":4}],"micro_answers":["Oppbevaring: Oppbevar fiskegryten i kjøleskapet i opptil 2 dager.","Tilberedningsmetode: Fiskegryten tilberedes ved koking.","Metode: kokt.","Allergener: melk, gluten.","Nøkkelingredienser: 2 ss meierismør, 1 ts karri, 0.5 stk purre."],"metadata":{"ingredients":["2 ss meierismør","1 ts karri","0.5 stk purre","0.5 stk løk","1 båt hvitløk","1 ss hvetemel","3 dl lettmelk","2 dl lett crème fraîche(evt vanlig crème fraîche)","400 g torskefilet","1 stk rød paprika","salt og pepper","1 ss frisk basilikum"],"category":null,"cooking_method":"kokt","allergens":["melk","gluten"],"signals":{"has_milk":true,"has_egg":false,"is_fried":false,"is_baked":false,"is_sweet":false}}},{"recipe":"Barnas beste chili con carne","primary_answer":"Rens løk og paprika, og skjær i tynne skiver før du lar dem frese i en stekepanne med meierismør. Smuldre i kjøttdeigen og la den bli brun, deretter tilsetter du hermetiske tomatbønner. Rør kremosten jevn i ketchupen og bland den inn i gryteretten.","faqs":[{"question":"Hvordan bør Barnas beste chili con carne oppbevares etter tilberedning?","answer":"Etter tilberedning bør retten avkjøles raskt og oppbevares i en lufttett beholder i kjøleskapet. Sørg for at kjøttdeigen og kremosten er helt avkjølt før lagring for å bevare smaken.","type":"storage","score":5},{"question":"Hvordan kan jeg gjøre Barnas beste chili con carne litt sunnere uten å miste karakteren sin?","answer":"Bytt ut meierismør med olivenolje for å redusere mettet fett, og bruk lett kremost i stedet for vanlig kremost for å redusere kaloriinnholdet.","type":"health","score":5},{"question":"Er det melk i barnas beste chili con carne?","answer":"Ja, oppskriften inneholder meierismør og kremost naturell, som begge er melkeprodukter.","type":"allergy","score":4},{"question":"Hvorfor blir ikke kjøttdeigen brun når jeg steker den?","answer":"Pass på at pannen er varm nok før du tilsetter kjøttdeigen, og unngå å overfylle pannen. Dette sikrer at kjøttdeigen får en fin brunfarge.","type":"technique","score":5}],"micro_answers":["Oppbevaring: Oppbevar rester i kjøleskap i lufttett beholder.","Tilberedningsmetode: Grønnsakene freses i smør før kjøttdeigen tilsettes.","Ingrediens: 2 stk Rød paprika brukes i gryten."],"metadata":{"ingredients":["2 stk løk","2 stk rød paprika","2 ss meierismør","400 g kjøttdeig","2 boks hermetiske tomatbønner","1 dl ketchup","125 g kremost naturell"],"category":"Gryter","cooking_method":"stekt","allergens":["melk"],"signals":{"has_milk":false,"has_egg":false,"is_fried":true,"is_baked":false,"is_sweet":false}}},{"recipe":"Daimiskake","primary_answer":"For å lage Daimiskake, visp eggehvitene stive og tilsett sukker for å lage en luftig marengs. Rør inn kokosmasse og sjokolade, og stek kaken i en forvarmet ovn på 175 °C i 35 minutter. Avkjøl før du legger på iskremblandingen.","faqs":[{"question":"Hvordan bør daimiskaken oppbevares etter tilberedning?","answer":"Etter tilberedning bør daimiskaken oppbevares i fryseren på grunn av iskremblandingen med kremfløte og gelatin. Ta den ut og la den stå i kjøleskapet i 30-60 minutter før servering for å få riktig konsistens.","type":"storage","score":5},{"question":"Hvordan kan jeg redusere sukkerinnholdet i daimiskaken uten å miste smaken?","answer":"Du kan redusere sukkeret i både marengsen og eggedosisen med 25% og erstatte noe av sukkeret med et naturlig søtningsmiddel som stevia. Dette vil bevare sødmen uten å påvirke smaken betydelig.","type":"health","score":4},{"question":"Kan jeg bytte ut eggene i daimiskaken?","answer":"I denne oppskriften kan du prøve å erstatte eggehvitene med aquafaba for marengsbunnen, og eggeplommene med en blanding av maisstivelse og vann for krokaniskremen. Dette kan påvirke teksturen, så vær oppmerksom på konsistensen under tilberedningen.","type":"substitution","score":3},{"question":"Inneholder daimiskaken melk?","answer":"Ja, daimiskaken inneholder melk i form av kremfløte som brukes både i iskremblandingen og til pynt.","type":"allergy","score":5},{"question":"Hvorfor blir ikke marengsbunnen stiv når jeg steker daimiskaken?","answer":"Sørg for å vispe eggehvitene stive før du gradvis tilsetter sukkeret. Dette gir en luftig og stiv marengs som holder formen under steking.","type":"technique","score":5}],"micro_answers":["Oppbevaring: Frys kaken i noen timer eller natten over.","Tilberedningsmetode: Ovnsbakt ved 175 °C.","Ingrediens: 6 stk Eggehvite."],"metadata":{"ingredients":["6 stk eggehvite","175 g sukker","175 g kokosmasse","5 stk gelatinplater","6 stk eggeplomme","150 g sukker","5 dl kremfløte","1.5 stk daim-sjokolade","1 dl kremfløte","0.5 stk daim-sjokolade","1 stk lys kokesjokolade"],"category":"Is","cooking_method":"ovnsbakt","allergens":["melk","egg"],"signals":{"has_milk":true,"has_egg":true,"is_fried":false,"is_baked":true,"is_sweet":true}}},{"recipe":"Iskake med  marengs ( Baked alaska )","primary_answer":"Pisk egg og sukker til eggedosis, sikt inn hvetemel og bakepulver, og stek sukkerbrødet i ovnen på 175 °C i ca. 35 minutter. Legg vaniljeis og bær på sukkerbrødbunnen, dekk med marengs, og ovnsbak kaken ved 250-300 °C i 5-10 minutter til marengsen er gyllen.","faqs":[{"question":"Hvordan bør iskaken med marengs oppbevares etter tilberedning?","answer":"Etter at iskaken er bakt og marengsen er gyllen, bør den serveres umiddelbart. Hvis du ikke skal servere den med en gang, kan kaken oppbevares i fryseren før steking.","type":"storage","score":5},{"question":"Hvordan kan jeg gjøre iskaken med marengs litt sunnere uten å miste karakteren sin?","answer":"Du kan redusere sukkeret i marengsen litt og bruke fullkornsmel i stedet for hvetemel i sukkerbrødet. Dette vil gi en sunnere variant uten å endre smaken for mye.","type":"health","score":5},{"question":"Kan jeg bytte ut eggene i iskaken med marengs?","answer":"I denne oppskriften er egg avgjørende for både sukkerbrødet og marengsen. Du kan prøve å bruke en egg-erstatning for sukkerbrødet, men det kan påvirke teksturen. For marengsen er det best å bruke eggehviter for å oppnå riktig konsistens.","type":"substitution","score":4},{"question":"Er det egg i iskaken med marengs?","answer":"Ja, oppskriften inneholder egg både i sukkerbrødet og i den italienske marengsen.","type":"allergy","score":4},{"question":"Hvorfor blir ikke marengsen gyllen når jeg steker iskaken med marengs?","answer":"Sørg for at ovnen er forvarmet til 250-300 °C og at marengsen dekker hele kaken godt. Stek i 5-10 minutter og følg nøye med, da det kan gå fort.","type":"technique","score":5}],"micro_answers":["Oppbevaring: Marengs kan lagres i kjøleskap i to dager.","Allergener: Inneholder egg og gluten.","Tilberedningsmetode: Ovnsbakt ved 250-300 °C.","Ingrediens: 1 l Vaniljeis.","Oppbevaring: Kaken kan fryses før steking."],"metadata":{"ingredients":["5 stk egg","150 g sukker","150 g hvetemel","1 ts bakepulver","250 g sukker","50 g vann","125 g eggehvite","1 l vaniljeis","150 g bringebær","50 g blåbær"],"category":"Is","cooking_method":"ovnsbakt","allergens":["egg","gluten"],"signals":{"has_milk":false,"has_egg":true,"is_fried":false,"is_baked":true,"is_sweet":true}}},{"recipe":"Banankake","primary_answer":"For å lage banankake, moser du godt modne bananer og blander dem med smør, sukker, egg, hvetemel, bakepulver og lettmelk. Hell røren i en brødform og ovnsbak kaken ved 180 °C i en time.","faqs":[{"question":"Hvordan bør banankaken oppbevares etter at den er ferdig stekt?","answer":"Etter at banankaken er avkjølt, bør den oppbevares i en lufttett beholder i kjøleskapet for å bevare fuktigheten fra de modne bananene.","type":"storage","score":5},{"question":"Kan jeg bytte ut melken i banankaken?","answer":"Ja, du kan bytte ut lettmelken med en plantebasert melk som mandel- eller soyamelk uten å påvirke smaken nevneverdig.","type":"substitution","score":5},{"question":"Inneholder banankaken melk, og kan den tilpasses for melkeallergikere?","answer":"Ja, banankaken inneholder lettmelk. For melkeallergikere kan du erstatte lettmelken med en plantebasert melk som mandel- eller soyamelk.","type":"allergy","score":4},{"question":"Hvorfor blir banankaken min for tørr etter steking?","answer":"Sørg for at du bruker godt modne bananer, da de tilfører fuktighet. Pass også på å ikke overblande røren, og sjekk kaken med en pinne for å unngå overstekning.","type":"technique","score":5}],"micro_answers":["Oppbevaring: Oppbevar banankake i lufttett beholder.","Allergener: inneholder melk, egg og gluten.","Tilberedningsmetode: Ovnsbakt ved 180 °C.","Ingredienser: 2 modne bananer, 100 g smør, 150 g sukker.","Steketid: Stek kaken i 1 time."],"metadata":{"ingredients":["2 stk banan(godt modne)","100 g smør","150 g sukker","2 stk egg","225 g hvetemel","2 ts bakepulver","0.5 dl lettmelk"],"category":"Kaker","cooking_method":"ovnsbakt","allergens":["melk","egg","gluten"],"signals":{"has_milk":true,"has_egg":true,"is_fried":false,"is_baked":true,"is_sweet":true}}},{"recipe":"Appelsinkake","primary_answer":"Rør smør og sukker lett og porøst, og tilsett eggene ett av gangen. Bland inn finrevet appelsinskall og appelsinsaft, og deretter mel blandet med bakepulver. Hell deigen i en smurt form og stek kaken ovnsbakt på 175 °C i ca. 45-50 minutter.","faqs":[{"question":"Hvordan bør appelsinkaken oppbevares etter at den er ferdig glasert?","answer":"Etter glasering bør appelsinkaken oppbevares i en lufttett beholder i kjøleskapet for å bevare fuktigheten fra appelsinsaften og smørret.","type":"storage","score":5},{"question":"Hvordan kan jeg gjøre appelsinkaken litt sunnere uten å miste karakteren sin?","answer":"Du kan redusere mengden sukker ved å bruke 150 g i stedet for 200 g, og erstatte noe av hvetemelet med fullkornsmel for mer fiber. Bruk gjerne ferskpresset appelsinsaft for glasuren for å redusere mengden melis.","type":"health","score":5},{"question":"Kan jeg bytte ut eggene i appelsinkaken med noe annet?","answer":"Ja, du kan bytte ut hvert egg med 1/4 kopp eplemos eller 1/4 kopp yoghurt for å beholde fuktigheten i kaken.","type":"substitution","score":5},{"question":"Er appelsinkaken glutenfri?","answer":"Nei, appelsinkaken inneholder hvetemel som er en kilde til gluten.","type":"allergy","score":4},{"question":"Hvorfor hever ikke appelsinkaken min ordentlig i ovnen?","answer":"Sørg for at bakepulveret er ferskt og at du blander det godt med melet før det tilsettes i deigen. Rør deigen til den er jevn, men unngå å overblande, da dette kan påvirke hevingen.","type":"technique","score":5}],"micro_answers":["Oppbevaring: Oppbevar kaken i en lufttett beholder.","Allergener: Inneholder melk, egg og gluten.","Tilberedningsmetode: Kaken er ovnsbakt.","Ingrediens: 200 g Meierismør brukes i oppskriften.","Steketid: Stek kaken i 45-50 minutter."],"metadata":{"ingredients":["200 g meierismør","200 g sukker","3 stk egg","1 stk appelsin","50 g syltet appelsinskall","1 ts bakepulver","240 g hvetemel","120 g melis","1.5 ss appelsinsaft","20 g syltet appelsinskall"],"category":"Kaker","cooking_method":"ovnsbakt","allergens":["melk","egg","gluten"],"signals":{"has_milk":false,"has_egg":true,"is_fried":false,"is_baked":true,"is_sweet":true}}},{"recipe":"Iskaffe CoffeeJoy","primary_answer":"Bland 1 pk iskaffe, 4 dl yoghurt naturell, 1 ss vaniljesukker, 1 stk banan og 1 ss honning i en foodprosessor til en jevn, fyldig masse. Tilsett isbiter og servér straks.","faqs":[{"question":"Hvordan bør Iskaffe CoffeeJoy oppbevares etter tilberedning?","answer":"Iskaffe CoffeeJoy bør oppbevares i kjøleskapet i en tett beholder og konsumeres innen 24 timer for å bevare smaken fra bananen og friskheten fra yoghurten.","type":"storage","score":5},{"question":"Hvordan kan jeg gjøre Iskaffe CoffeeJoy litt sunnere uten å miste karakteren sin?","answer":"Bytt ut vaniljesukker med ekte vaniljeekstrakt og bruk gresk yoghurt i stedet for vanlig yoghurt for mer protein og mindre sukker.","type":"health","score":5},{"question":"Kan jeg bytte ut yoghurt naturell i iskaffe CoffeeJoy med noe annet?","answer":"Ja, du kan bytte ut yoghurt naturell med kokosmelk for en fyldigere smak, men det kan påvirke konsistensen litt.","type":"substitution","score":5},{"question":"Inneholder iskaffe CoffeeJoy melk eller melkeprodukter?","answer":"Ja, iskaffe CoffeeJoy inneholder yoghurt naturell, som er et melkeprodukt.","type":"allergy","score":4}],"micro_answers":["Oppbevaring: Server straks for best smak.","Ingredienser: Iskaffe, yoghurt, vaniljesukker, banan, honning.","Metode: blandet.","Kategori: Kalde drikker.","Allergener: melk."],"metadata":{"ingredients":["1 pk iskaffe","4 dl yoghurt naturell","1 ss vaniljesukker","1 stk banan","1 ss honning"],"category":"Kalde drikker","cooking_method":"blandet","allergens":["melk"],"signals":{"has_milk":true,"has_egg":false,"is_fried":false,"is_baked":false,"is_sweet":true}}},{"recipe":"Is-chai latte","primary_answer":"Brygg chai te ved å la en pose trekke i varmt vann i 10 minutter, og avkjøl deretter. Hell den avkjølte teen og melk over isbiter i et glass, og bland godt. Topp med malt kanel for ekstra smak.","faqs":[{"question":"Hvordan bør is-chai latte oppbevares etter tilberedning?","answer":"Is-chai latte bør oppbevares i kjøleskapet i en lufttett beholder for å bevare smaken av chai-te og melk. Drikken bør konsumeres innen 24 timer for best smak.","type":"storage","score":5},{"question":"Hvordan kan jeg gjøre is-chai latte litt sunnere uten å miste karakteren sin?","answer":"Bytt ut vanlig melk med lettmelk eller en usøtet plantebasert melk, og reduser mengden søtning eller bruk et naturlig søtningsmiddel som honning i stedet for sukker.","type":"health","score":5},{"question":"Kan jeg bytte ut melken i is-chai latte med et annet meieriprodukt?","answer":"Ja, du kan bytte ut melken med havremelk eller mandelmelk for en laktosefri variant. Dette vil gi en litt annen smak, men fungerer fint i oppskriften.","type":"substitution","score":5},{"question":"Er det melk i is-chai latte oppskriften?","answer":"Ja, oppskriften inneholder 2 dl melk som en av hovedingrediensene.","type":"allergy","score":4}],"micro_answers":["Oppbevaring: Serveres umiddelbart etter tilberedning.","Allergener: Inneholder melk og gluten.","Tilberedningsmetode: Drikken er blandet.","Ingrediens: Inneholder chai te og melk.","Oppbevaring: Avkjøl te før blanding."],"metadata":{"ingredients":["1 pose chai te","2 dl vann","2 dl melk","10 stk isbiter","0.5 ts malt kanel"],"category":"Kalde drikker","cooking_method":"blandet","allergens":["melk","gluten"],"signals":{"has_milk":true,"has_egg":false,"is_fried":false,"is_baked":false,"is_sweet":true}}},{"recipe":"Omelettmuffins","primary_answer":"Visp sammen egg og melk, og tilsett revet gulost og hakkede ingredienser som vårløk og kokt skinke. Fyll muffinsformene nesten fulle og stek omelettene midt i ovnen på 180° C i ca. 15 minutter til de såvidt har stivnet.","faqs":[{"question":"Hvordan bør omelettmuffins oppbevares etter tilberedning?","answer":"Omelettmuffins bør avkjøles helt før de legges i en lufttett beholder og oppbevares i kjøleskapet. De kan holde seg ferske i 2-3 dager.","type":"storage","score":5},{"question":"Hvordan kan jeg gjøre omelettmuffins litt sunnere uten å miste karakteren sin?","answer":"Bytt ut melk med lettmelk eller en plantebasert melk for å redusere fettinnholdet, og bruk mindre ost eller en magrere ostetype for å redusere kalorier uten å miste smaken.","type":"health","score":5},{"question":"Kan jeg bytte ut melken i omelettmuffins med en plantebasert melk?","answer":"Ja, du kan bytte ut melken med en plantebasert melk som mandel- eller havremelk uten å påvirke tilberedningsmetoden. Dette kan gi en litt annen smak, men fungerer fint i oppskriften.","type":"substitution","score":5},{"question":"Er det mulig å lage omelettmuffins uten melk?","answer":"Ja, du kan erstatte melken med en plantebasert melk som havremelk eller mandelmelk for å unngå melk i oppskriften.","type":"allergy","score":4},{"question":"Hvorfor blir omelettmuffinsene mine for våte i midten?","answer":"Sørg for å ikke overfylle muffinsformene og at ovnen er forvarmet til 180° C. Hvis de fortsatt er våte, kan du forlenge steketiden med noen minutter til de har stivnet helt.","type":"technique","score":5}],"micro_answers":["Oppbevaring: Omelettmuffins kan lagres i kjøleskap i 3 dager.","Allergener: Inneholder melk, egg og gluten.","Tilberedningsmetode: Omelettmuffins er ovnsbakt.","Ingrediens: 6 stk Egg er hovedingrediens.","Tilberedning: Stek omelettene i ovnen i 15 minutter."],"metadata":{"ingredients":["6 stk egg","1 dl melk","2 stk vårløk(eller løk)","150 g kokt skinke(eller fetaost)","50 g tomat(soltørket)","25 g sorte oliven(uten stein)","100 g revet gulost","0.5 ts salt"],"category":null,"cooking_method":"ovnsbakt","allergens":["melk","egg","gluten"],"signals":{"has_milk":true,"has_egg":true,"is_fried":false,"is_baked":true,"is_sweet":false}}},{"recipe":"Frittata med ost og skinke","primary_answer":"Skjær løk i tynne skiver og stek den i litt olje til den er myk. Tilsett paprika og smårettskinke, og stek til alt har fått litt farge. Hell deretter en blanding av egg, fløte og sennep over, og stek på middels varme til eggene har stivnet.","faqs":[{"question":"Hvordan bør frittata med ost og skinke oppbevares etter tilberedning?","answer":"Etter tilberedning bør frittataen avkjøles helt, deretter oppbevares i en lufttett beholder i kjøleskapet. Dette vil bevare smaken av smårettskinke og ost, og holde retten fersk i opptil 2-3 dager.","type":"storage","score":5},{"question":"Hvordan kan jeg gjøre frittata med ost og skinke litt sunnere uten å miste karakteren sin?","answer":"Bytt ut matfløten med en lett melk eller plantebasert alternativ, og bruk en magrere ostetype. Du kan også legge til flere grønnsaker som spinat eller brokkoli for ekstra næring.","type":"health","score":5},{"question":"Kan jeg bytte ut eggene i frittata med ost og skinke med en annen ingrediens?","answer":"Du kan prøve å bruke kikertmel blandet med vann som en erstatning for egg, men det kan påvirke teksturen og smaken av frittataen.","type":"substitution","score":5},{"question":"Er det melk i frittata med ost og skinke?","answer":"Ja, oppskriften inneholder både gulost og matfløte, som begge er melkeprodukter.","type":"allergy","score":4},{"question":"Hvorfor blir frittataen min ofte brent i bunnen?","answer":"Pass på å steke på middels varme og bruk en panne med non-stick belegg. Dette gir jevn varmefordeling og forhindrer at frittataen brenner seg fast.","type":"technique","score":5}],"micro_answers":["Oppbevaring: Kjøleskap, i lufttett beholder.","Allergener: Inneholder melk og egg.","Tilberedningsmetode: Stekt på middels varme.","Ingrediens: 200 g smårettskinke.","Ingrediens: 100 g gulost."],"metadata":{"ingredients":["1 stk løk","1 stk snackpaprika (spiss paprika)","200 g smårettskinke","100 g gulost","8 stk egg","0.5 dl matfløte","1 ts dijonsennep","2 stk vårløk"],"category":"Omeletter","cooking_method":"stekt","allergens":["melk","egg"],"signals":{"has_milk":true,"has_egg":true,"is_fried":true,"is_baked":false,"is_sweet":false}}},{"recipe":"Ostesmørbrød med smørstekt squash og kremost","primary_answer":"Skjær squash i tynne skiver og stek dem sammen med spinat til de er gyldne. Smør pesto på brødskiver, legg på squashblandingen og ost, og stek dem ovnsbakt på 220 °C til osten har smeltet.","faqs":[{"question":"Hvordan bør ostesmørbrød med smørstekt squash og kremost oppbevares etter tilberedning?","answer":"Oppbevar ostesmørbrødene i en lufttett beholder i kjøleskapet. For best resultat, varm dem opp i ovnen for å bevare sprøheten før servering.","type":"storage","score":5},{"question":"Hvordan kan jeg gjøre ostesmørbrød med smørstekt squash og kremost litt sunnere uten å miste karakteren sin?","answer":"Bytt ut smør med olivenolje for steking, og bruk fullkornsbrød i stedet for vanlig brød for mer fiber. Du kan også redusere mengden gulost og bruke en lettere kremostvariant.","type":"health","score":5},{"question":"Kan jeg bytte ut kremosten i ostesmørbrød med smørstekt squash og kremost med et annet meieriprodukt?","answer":"Ja, du kan bytte ut kremosten med ricotta eller mascarpone for en lignende kremet konsistens. Pass på å justere mengden salt etter smak, da disse alternativene kan ha ulik saltinnhold.","type":"substitution","score":5},{"question":"Inneholder ostesmørbrød med smørstekt squash og kremost melk?","answer":"Ja, oppskriften inneholder både kremost og gulost, som begge er melkeprodukter.","type":"allergy","score":4},{"question":"Hvorfor blir ostesmørbrødene mine soggy etter steking i ovnen?","answer":"Pass på å tørke av overflødig væske fra squashen etter salting, og stek brødskivene til de er gylne og sprø før du legger på fyllet. Dette vil bidra til å holde smørbrødene sprø.","type":"technique","score":5}],"micro_answers":["Oppbevaring: Oppbevar ferdige ostesmørbrød i kjøleskap, spis innen 2 dager.","Allergen: Inneholder melk fra kremost og gulost.","Tilberedningsmetode: Ovnsbakt ved 220 °C til osten smelter.","Ingrediens: Bruk frisk spinat og grønn squash for best resultat.","Steketips: Stek brødskivene i smør med hvitløk for ekstra smak."],"metadata":{"ingredients":["1 pk frisk spinat","1 stk grønn squash","salt og pepper","50 g ruccola","6 skive brød","6 ss pesto","kremost","9 skive gulost","smør til steking","1 båt hvitløk"],"category":null,"cooking_method":"ovnsbakt","allergens":["melk"],"signals":{"has_milk":true,"has_egg":false,"is_fried":true,"is_baked":true,"is_sweet":false}}},{"recipe":"Arme riddere","primary_answer":"Visp sammen egg, melk, sukker og kardemomme, og hell blandingen over brødskivene til de er gjennombløte. Smelt smør i en stekepanne og stek brødskivene pent gulbrune på begge sider.","faqs":[{"question":"Hvordan bør arme riddere oppbevares etter tilberedning?","answer":"Etter steking bør arme riddere avkjøles helt før de legges i en lufttett beholder og oppbevares i kjøleskapet. Dette forhindrer at de blir soggy og bevarer smaken av kardemomme og sukker.","type":"storage","score":5},{"question":"Hvordan kan jeg gjøre arme riddere litt sunnere uten å miste karakteren sin?","answer":"Bytt ut lettmelk med skummet melk for å redusere fettinnholdet, og bruk en mindre mengde sukker eller et naturlig søtningsmiddel som honning. Stek i en non-stick panne for å redusere behovet for smør.","type":"health","score":5},{"question":"Kan jeg bytte ut melken i arme riddere med en plantebasert melk?","answer":"Ja, du kan bruke mandelmelk eller havremelk som erstatning for lettmelk. Dette vil gi en litt annen smak, men fungerer fint i oppskriften.","type":"substitution","score":5},{"question":"Er det mulig å lage arme riddere uten melk?","answer":"Ja, du kan erstatte lettmelken med en plantebasert melk som mandelmelk eller havremelk for å unngå melk i oppskriften.","type":"allergy","score":4},{"question":"Hvorfor blir ikke arme ridderne mine gyllenbrune når jeg steker dem?","answer":"Pass på at smøret er godt smeltet og pannen er varm før du legger i brødskivene. Dette sikrer en jevn og gyllenbrun steking.","type":"technique","score":5}],"micro_answers":["Oppbevaring: Serveres nystekte, ikke egnet for langtidslagring.","Allergener: Inneholder melk, egg og gluten.","Tilberedningsmetode: Stekt i smør til gyllenbrun.","Ingrediens: Brødskiver bløtlegges i egg- og melkeblanding.","Kategori: Ostesmørbrød, kjent som Arme riddere."],"metadata":{"ingredients":["4 skiver brød","1 stk egg","1.5 dl lettmelk","1 ss sukker","0.5 ts malt kardemomme"],"category":"Ostesmoerbroed","cooking_method":"stekt","allergens":["melk","egg","gluten"],"signals":{"has_milk":true,"has_egg":true,"is_fried":true,"is_baked":false,"is_sweet":true}}},{"recipe":"Eggesalat","primary_answer":"Kok eggene og del dem i små biter før de avkjøles. Bland finhakket vårløk med sennep, majones og lettrømme, og smak til med salt og pepper. Vend forsiktig inn de kokte eggene i blandingen.","faqs":[{"question":"Hvordan bør eggesalaten oppbevares etter tilberedning?","answer":"Eggesalaten bør oppbevares i en lufttett beholder i kjøleskapet for å bevare friskheten til ingrediensene som vårløk og rømme. Den bør konsumeres innen 2-3 dager.","type":"storage","score":5},{"question":"Hvordan kan jeg redusere fettinnholdet i eggesalaten uten å endre smaken for mye?","answer":"Du kan bytte ut majonesen med gresk yoghurt for å redusere fettinnholdet, samtidig som du beholder kremet konsistens og smak.","type":"health","score":5},{"question":"Kan jeg bytte ut eggene i denne eggesalaten?","answer":"Ja, du kan erstatte eggene med kokte kikerter for en plantebasert variant. Mos kikertene lett før du blander dem inn med de andre ingrediensene.","type":"substitution","score":4},{"question":"Er det melk i denne eggesalaten?","answer":"Ja, eggesalaten inneholder lettrømme, som er et melkeprodukt.","type":"allergy","score":4}],"micro_answers":["Oppbevaring: Kjøleskap, i lufttett beholder.","Allergener: Inneholder melk og egg.","Tilberedningsmetode: Kokt egg.","Ingrediens: 1 stk Vårløk.","Tilsett salt og pepper etter smak."],"metadata":{"ingredients":["1 stk vårløk","6 stk egg","1 ts sennep","1 ss majones","2 dl lettrømme","salt og pepper"],"category":null,"cooking_method":"kokt","allergens":["melk","egg"],"signals":{"has_milk":false,"has_egg":true,"is_fried":false,"is_baked":false,"is_sweet":false}}},{"recipe":"Grove fiskekaker","primary_answer":"Del torskefileten i biter og kjør den i en foodprosessor med salt til en jevn masse. Tilsett lettmelk, potetmel, pepper og dill, form til kaker og stek dem i smør på middels varme til de er gjennomstekte.","faqs":[{"question":"Hvordan bør de grove fiskekakene oppbevares etter tilberedning?","answer":"Etter steking bør de grove fiskekakene avkjøles og deretter oppbevares i en lufttett beholder i kjøleskapet. Dette vil bevare smaken av torskefileten og den friske dillen.","type":"storage","score":5},{"question":"Hvordan kan jeg gjøre de grove fiskekakene litt sunnere uten å miste smaken?","answer":"Bytt ut smøret med olivenolje for steking, og bruk skummet melk i stedet for lettmelk for å redusere fettinnholdet uten å påvirke smaken for mye.","type":"health","score":5},{"question":"Kan jeg bytte ut lettmelken i de grove fiskekakene?","answer":"Ja, du kan bytte ut lettmelken med havremelk eller soyamelk for et laktosefritt alternativ. Dette vil ikke påvirke tilberedningsmetoden.","type":"substitution","score":5},{"question":"Inneholder de grove fiskekakene melk?","answer":"Ja, oppskriften inneholder 1.5 dl lettmelk.","type":"allergy","score":3},{"question":"Hvorfor faller fiskekakene fra hverandre under steking?","answer":"Fiskekakene kan falle fra hverandre hvis massen ikke er jevn nok. Sørg for å kjøre fisken til en jevn masse i foodprosessoren og tilsett potetmel for å binde ingrediensene sammen.","type":"technique","score":5}],"micro_answers":["Oppbevaring: Kjøleskap i lufttett beholder.","Tilberedningsmetode: Stekt i smør.","Ingrediens: 500 g torskefilet."],"metadata":{"ingredients":["1 ts salt","1.5 dl lettmelk","1 ss potetmel","1 krm pepper","1 ss frisk dill","2 ss smør","500 g torskefilet"],"category":"Paalegg","cooking_method":"stekt","allergens":["melk","gluten"],"signals":{"has_milk":true,"has_egg":false,"is_fried":true,"is_baked":false,"is_sweet":false}}},{"recipe":"Quiche","primary_answer":"Smuldre 125 g meierismør og 200 g hvetemel, tilsett 2 ss vann og lag en jevn deig som trykkes ut i en paiform og forstekes. Fordel stekt løk og brokkoli i paiskallet, hell over en blanding av egg og melk, og ovnsbak quichen ved 180 °C i ca 20 minutter til eggeblandingen er stivnet.","faqs":[{"question":"Hvordan bør quichen oppbevares etter tilberedning?","answer":"Etter tilberedning bør quichen avkjøles helt og deretter oppbevares i kjøleskapet, godt tildekket med plastfolie eller i en lufttett beholder, for å bevare smaken av skinke, laks eller ansjos og forhindre at osten tørker ut.","type":"storage","score":4},{"question":"Hvordan kan jeg redusere fettinnholdet i quichen uten å miste smaken?","answer":"Bytt ut noe av smøret i paibunnen med kesam eller gresk yoghurt, og bruk lettmelk i stedet for helmelk i eggeblandingen.","type":"health","score":5},{"question":"Kan jeg bytte ut melken i quichen med en plantebasert melk?","answer":"Ja, du kan bytte ut melken med en usøtet plantebasert melk som havremelk eller mandelmelk for å bevare konsistensen i eggeblandingen.","type":"substitution","score":5},{"question":"Er det gluten i denne quichen?","answer":"Ja, quichen inneholder hvetemel i paibunnen, som er en kilde til gluten.","type":"allergy","score":4},{"question":"Hvorfor blir quichen min for bløt i midten etter steking?","answer":"Sørg for å forsteke paibunnen i ca 15 minutter før du tilsetter fyllet, og pass på at eggeblandingen er godt blandet før du heller den over osten. Dette hjelper til med å sikre at quichen stivner ordentlig under steking.","type":"technique","score":5}],"micro_answers":["Oppbevaring: Quiche bør oppbevares kjølig, helst i kjøleskap.","Allergener: Quiche inneholder melk, egg og gluten.","Tilberedningsmetode: Quiche er ovnsbakt ved 180 °C.","Ingrediens: Quiche inneholder 125 g Meierismør."],"metadata":{"ingredients":["125 g meierismør","200 g hvetemel","2 ss vann","1 stk løk","1 ss meierismør","150 g kokt skinke, røkelaks eller ansjosfilet i små biter","4 stk egg","3 dl melk","2 ss frisk kruspersille","0.5 ts pepper","250 g revet gulost","1 stk brokkoli"],"category":"Paier","cooking_method":"ovnsbakt","allergens":["melk","egg","gluten"],"signals":{"has_milk":true,"has_egg":true,"is_fried":false,"is_baked":true,"is_sweet":false}}},{"recipe":"Ostepai med kvargbunn","primary_answer":"For å lage ostepai med kvargbunn, bland hvetemel, smør, kvarg, salt og vann i en foodprosessor, og la deigen hvile kjølig i 30 minutter. Kjevle ut deigen, legg den i en paiform, og forstek i ovnen på 200 °C i 15 minutter. Fyll paiskallet med stekt løk, bacon, vårløk, ost og en blanding av egg, fløte og gressløk, og ovnsbak paien videre ved 180 °C i ca 20 minutter.","faqs":[{"question":"Hvordan bør ostepaien med kvargbunn oppbevares etter tilberedning?","answer":"Etter tilberedning bør ostepaien avkjøles til romtemperatur og deretter oppbevares i kjøleskapet, godt tildekket, for å bevare smaken av den vellagrede osten og sprøheten i baconet.","type":"storage","score":5},{"question":"Hvordan kan jeg gjøre ostepaien med kvargbunn litt sunnere uten å miste karakteren sin?","answer":"Bytt ut noe av hvetemelet med fullkornsmel for mer fiber, og bruk kalkunbacon i stedet for vanlig bacon for å redusere fettinnholdet. Du kan også erstatte matfløten med en lettere fløtevariant.","type":"health","score":5},{"question":"Kan jeg bytte ut eggene i ostepaien med noe annet?","answer":"Ja, du kan erstatte eggene med en blanding av 1 ss linfrø og 2,5 ss vann per egg. La blandingen stå i noen minutter til den tykner før du bruker den i eggeblandingen.","type":"substitution","score":5},{"question":"Er det mulig å lage denne ostepaien uten melk?","answer":"Ja, du kan erstatte kvarg og matfløte med plantebaserte alternativer for å unngå melk i ostepaien.","type":"allergy","score":4},{"question":"Hvorfor blir ikke ostepaien min gyllen på toppen?","answer":"Sørg for at osten er jevnt fordelt over fyllet før du heller over eggeblandingen, og stek paien til eggeblandingen er stivnet ved 180 °C i ca 20 minutter for å få en gyllen overflate.","type":"technique","score":5}],"micro_answers":["Oppbevaring: Ostepai bør oppbevares kjølig, helst i kjøleskap.","Tilberedningsmetode: Ostepai er ovnsbakt.","Ingrediens: 1.5 dl Kvarg naturell (f.eks Kesam).","Steketid: Forstek paiskallet i 15 minutter."],"metadata":{"ingredients":["210 g hvetemel","60 g smør","1.5 dl kvarg naturell (f.eks kesam)","0.5 ts salt","2 ss vann","1 stk løk","1 ss meierismør","150 g bacon","1 stk vårløk","150 g vellagret ost","4 stk egg","2.5 dl matfløte","2 ss frisk gressløk"],"category":"Paier","cooking_method":"ovnsbakt","allergens":["melk","egg","gluten"],"signals":{"has_milk":true,"has_egg":true,"is_fried":false,"is_baked":true,"is_sweet":false}}},{"recipe":"Pannekaker (grunnoppskrift)","primary_answer":"Bland hvetemel og salt i en bolle, visp sammen melk og egg, og bland det gradvis inn i melet til røren er glatt. Stek pannekakene i en varm teflonpanne med litt smør til de er gyllenbrune på begge sider.","faqs":[{"question":"Hvordan kan jeg gjøre pannekakene litt sunnere uten å miste smaken?","answer":"Bytt ut 1,5 dl av hvetemelet med 1 dl sammalt hvete fin og 0,5 dl lettkokte havregryn for mer fiber, og bruk en non-stick panne for å redusere mengden smør som trengs til steking.","type":"health","score":5},{"question":"Kan jeg bytte ut melken i denne pannekakeoppskriften med noe annet?","answer":"Ja, du kan bruke plantemelk som havremelk eller mandelmelk i stedet for lettmelk. Dette kan påvirke smaken litt, men fungerer fint i røren.","type":"substitution","score":5},{"question":"Er det mulig å lage pannekakene uten melk?","answer":"Ja, du kan erstatte lettmelken med en melkefri alternativ som mandelmelk eller havremelk for å unngå melk i oppskriften.","type":"allergy","score":4},{"question":"Hvorfor blir pannekakene mine ofte for tykke og vanskelige å snu?","answer":"Sørg for at røren er glatt og uten klumper ved å vispe melk og egg gradvis inn i melet. Hell bare nok røre i pannen til å dekke bunnen tynt, og drei pannen for jevn fordeling.","type":"technique","score":5}],"micro_answers":["Oppbevaring: Røren kan stå i kjøleskapet i 24 timer.","Allergener: Inneholder melk, egg og gluten.","Tilberedningsmetode: Pannekaker stekes i teflonpanne.","Ingrediens: 3 dl hvetemel, 6 dl lettmelk, 4 egg.","Tips: Bytt ut noe hvetemel med sammalt hvete for mer fiber."],"metadata":{"ingredients":["3 dl hvetemel","0.5 ts salt","6 dl lettmelk","4 stk egg","2 ss smør"],"category":null,"cooking_method":"stekt","allergens":["melk","egg","gluten"],"signals":{"has_milk":true,"has_egg":true,"is_fried":true,"is_baked":false,"is_sweet":false}}},{"recipe":"Amerikanske pannekaker med sirup","primary_answer":"Bland hvetemel, sukker, salt og bakepulver i en bolle. Visp sammen egg og melk, og rør det inn i de tørre ingrediensene til røren er glatt. Stek pannekakene i en panne, og hold dem varme i ovnen på 100 °C etter hvert som de blir ferdige.","faqs":[{"question":"Hvordan bør de amerikanske pannekakene oppbevares etter tilberedning?","answer":"Oppbevar de avkjølte pannekakene i en lufttett beholder i kjøleskapet i opptil 2 dager. Varm dem opp i ovnen på lav temperatur for å bevare den myke konsistensen før servering.","type":"storage","score":5},{"question":"Hvordan kan jeg gjøre de amerikanske pannekakene litt sunnere uten å miste karakteren sin?","answer":"Bytt ut hvetemelet med en blanding av fullkornsmel og havremel for mer fiber, og bruk honning i stedet for sukker for en naturlig sødme. Du kan også redusere mengden smør ved å bruke en non-stick panne.","type":"health","score":5},{"question":"Kan jeg bytte ut eggene i denne oppskriften med noe annet?","answer":"Ja, du kan erstatte eggene med 1 ss chiafrø blandet med 3 ss vann per egg. La blandingen svelle i 10 minutter før du tilsetter den i røren.","type":"substitution","score":5},{"question":"Er det gluten i denne oppskriften på amerikanske pannekaker?","answer":"Ja, oppskriften inneholder hvetemel som er en kilde til gluten.","type":"allergy","score":4},{"question":"Hvorfor blir pannekakene mine ofte svidd utenpå og rå inni?","answer":"Det kan skyldes for høy varme på platen. Sørg for å steke pannekakene på middels varme slik at de blir jevnt stekt uten å bli svidd.","type":"technique","score":5}],"micro_answers":["Oppbevaring: Oppbevar pannekaker i kjøleskap i opptil 3 dager.","Allergener: Inneholder melk, egg og gluten.","Tilberedningsmetode: Stek pannekaker i stekepanne, hold varme i ovn.","Ingrediens: 5 dl hvetemel er nødvendig for oppskriften.","Servering: Server med lønnesirup og smør."],"metadata":{"ingredients":["5 dl hvetemel","2 ss sukker","1 ts salt","1.5 ts bakepulver","5 dl lettmelk","2 stk egg","4 ss smør","2 dl mapel sirup"],"category":"Pannekaker","cooking_method":"ovnsbakt","allergens":["melk","egg","gluten"],"signals":{"has_milk":true,"has_egg":true,"is_fried":true,"is_baked":true,"is_sweet":true}}},{"recipe":"Lasagne","primary_answer":"Finhakk løk, gulrot og stangselleri, og stek dem i litt olje før du tilsetter kjøttdeig og bacon. Legg lagvis med lasagneplater, kjøttsaus og hvit saus i en ildfast form, dryss revet ost på toppen, og ovnsbak lasagnen ved 220 °C i 20-30 minutter.","faqs":[{"question":"Hvordan kan jeg redusere fettinnholdet i lasagneoppskriften uten å endre smaken for mye?","answer":"Bytt ut bacon med kalkunbacon og bruk lettmelk i den hvite sausen. Du kan også redusere mengden ost eller bruke en lettere ostetype.","type":"health","score":5},{"question":"Hvorfor blir lasagnen min ofte for tørr etter steking?","answer":"Sørg for å bruke nok hvit saus og kjøttsaus mellom lagene med lasagneplater, og pass på at sausen er tykk nok før du legger den i formen. Dette vil bidra til å holde lasagnen saftig under stekingen.","type":"technique","score":5}],"micro_answers":["Oppbevaring: Lasagne kan fryses i opptil 3 måneder.","Tilberedningsmetode: Lasagne er ovnsbakt ved 220 °C.","Ingrediens: Inneholder 400 g kjøttdeig og 12 lasagneplater.","Tilberedning: Stek grønnsaker og kjøttdeig før lagvis montering."],"metadata":{"ingredients":["1 stk løk","1 stk gulrot","2 stk stilkselleri (stangselleri)","1 pk bacon","400 g kjøttdeig","0.5 ts salt","0.5 ts pepper","0.5 ts tørket oregano","0.5 ts tørket basilikum","1 stk laurbærblad","1 ts sukker","400 g hermetiske tomater","1 boks tomatpuré","1.5 dl kjøttbuljong (utblandet)","2 ss meierismør","2 ss hvetemel","4.5 dl melk","revet muskatnøtt, salt og pepper","12 stk lasagneplater","100 g gulost","olje til steking"],"category":"Pasta","cooking_method":"ovnsbakt","allergens":["melk","gluten"],"signals":{"has_milk":true,"has_egg":false,"is_fried":false,"is_baked":true,"is_sweet":true}}},{"recipe":"Ovnsbakt pasta","primary_answer":"For å lage ovnsbakt pasta, start med å ovnsbake auberginen ved 200 °C til skallet løsner, omtrent 30 minutter. Kok pastaen til den er halvveis ferdig, og bland den med tomatsaus og hvit saus i en ildfast form. Topp med revet ost og stek ved 220 °C til osten er gyllen og boblete.","faqs":[{"question":"Hvordan bør ovnsbakt pasta oppbevares etter tilberedning?","answer":"La ovnsbakt pasta avkjøles helt, dekk den til med plastfolie eller legg den i en lufttett beholder, og oppbevar i kjøleskapet i opptil 3 dager. Dette vil bevare smaken fra de soltørkede tomatene og den kremete hvite sausen.","type":"storage","score":4},{"question":"Hvordan kan jeg gjøre ovnsbakt pasta litt sunnere uten å miste karakteren sin?","answer":"Bytt ut rapsolje med olivenolje for sunnere fett, og bruk fullkornspasta i stedet for vanlig pasta for mer fiber. Reduser mengden ost eller bruk en lettere ost for å kutte ned på kalorier.","type":"health","score":5},{"question":"Hvorfor blir ikke osten på toppen av ovnsbakt pasta gyllen og boblete?","answer":"Sørg for at ovnen er forvarmet til 220 grader og bruk en smaksrik ost som cheddar eller ridderost for best resultat. Stek til osten er gyllen og boblete, ca 15 minutter.","type":"technique","score":5}],"micro_answers":["Oppbevaring: Oppbevar rester i kjøleskap, maks 3 dager.","Tilberedningsmetode: Retten er ovnsbakt ved 220 grader.","Ingrediens: Inneholder aubergine og soltørkede tomater.","Tilberedning: Kok pasta til halv koketid."],"metadata":{"ingredients":["1 stk aubergine","1 stk løk","3 båt hvitløk","3 stk gulrot","2 stilk stilkselleri (stangselleri)","2 ss rapsolje","2 boks hermetiske tomater","1 ts sukker","1 ts balsamicoeddik","1 stk grønnsakbuljong (terning)","3 dl vann","250 g pasta penne","70 g soltørkede tomater","25 g sorte oliven","2 ss smør","2 ss hvetemel","4.5 dl melk","100 g revet gulost"],"category":"Pasta","cooking_method":"ovnsbakt","allergens":["melk","gluten"],"signals":{"has_milk":true,"has_egg":false,"is_fried":false,"is_baked":true,"is_sweet":true}}},{"recipe":"Pizza","primary_answer":"Smuldre gjæren i en bolle og tilsett lunkent vann, smeltet smør og salt før du rører inn hvetemelet til deigen er smidig. Etter å ha hevet deigen, kjevle den ut og legg den på en papirkledd stekeplate før du smører på tomatsausen. Ovnsbak pizzaen ved 225 °C i ca 15 minutter.","faqs":[{"question":"Er det melk i denne pizzaoppskriften?","answer":"Ja, oppskriften inneholder meierismør og revet gulost, som begge er melkeprodukter.","type":"allergy","score":4},{"question":"Hvorfor blir pizzabunnen min ofte for myk etter steking?","answer":"Sørg for at deigen hever til dobbel størrelse før du kjevler den ut, og pass på at sausen ikke er for flytende ved å koke den til passe tykkelse. Dette vil hjelpe bunnen med å bli sprøere.","type":"technique","score":4}],"micro_answers":["Oppbevaring: Pizza bør oppbevares i kjøleskap etter steking.","Tilberedningsmetode: Ovnsbakt ved 225 °C i 15 minutter.","Ingrediens: 25 g gjær brukes i deigen.","Tilberedning: Smør sausen på pizzabunnen før steking."],"metadata":{"ingredients":["25 g gjær","2 dl vann","1 ts salt","1 ss meierismør, smeltet","300 g hvetemel","400 g hermetiske tomater","4 ss chilisaus","1 båt hvitløk","1 ts tørket oregano","1 ts tørket basilikum","1 ts sukker","salt og pepper","valgfri pizzatopping"],"category":null,"cooking_method":"ovnsbakt","allergens":["melk","gluten"],"signals":{"has_milk":false,"has_egg":false,"is_fried":false,"is_baked":true,"is_sweet":true}}},{"recipe":"Auberginepizza","primary_answer":"Skjær auberginen i ca 1 cm tykke skiver og fordel dem på en langpanne kledd med bakepapir. Stek aubergineskivene i ovnen på 220 °C i cirka 15 minutter til de er gylne. Smør crème fraîche eller pizzasaus på de ovnsbakte skivene, topp med revet ost, rødløk, cherrytomater og spekeskinke, og stek videre i 10 minutter til osten er smeltet.","faqs":[{"question":"Hvordan bør auberginepizza oppbevares etter tilberedning?","answer":"La auberginepizzaen avkjøles helt, og oppbevar den deretter i en lufttett beholder i kjøleskapet. Den bør spises innen 2-3 dager for best smak og kvalitet.","type":"storage","score":5},{"question":"Hvordan kan jeg redusere fettinnholdet i auberginepizzaen uten å miste smaken?","answer":"Bytt ut spekeskinken med kalkunskinke og bruk en mindre mengde ost, eller velg en lettere ostetype. Du kan også redusere mengden olivenolje ved å bruke en sprayflaske for jevn fordeling.","type":"health","score":5},{"question":"Er det melk i auberginepizzaen?","answer":"Ja, auberginepizzaen inneholder melk i form av crème fraîche og revet gulost.","type":"allergy","score":4},{"question":"Hvorfor blir ikke aubergineskivene gylne etter steking?","answer":"Sørg for å pensle aubergineskivene med nok olivenolje og krydre med salt og pepper før steking. Dette hjelper dem å bli gylne og smakfulle etter 15 minutter i ovnen.","type":"technique","score":5}],"micro_answers":["Oppbevaring: Kjøleskap i lufttett beholder.","Tilberedningsmetode: Ovnsbakt ved 220 °C.","Ingrediens: 1 stk Aubergine.","Steketid: Cirka 25 minutter totalt."],"metadata":{"ingredients":["1 stk aubergine","0.25 stk rødløk","5 stk rød cherrytomat","3 ss crème fraîche lett, 10 %","3 ss pizzasaus","4 skive spekeskinke(eks serranoskinke)","100 g revet gulost","frisk basilikum"],"category":"Pizza","cooking_method":"ovnsbakt","allergens":["melk"],"signals":{"has_milk":false,"has_egg":false,"is_fried":true,"is_baked":true,"is_sweet":false}}},{"recipe":"Cæsarsalat","primary_answer":"Bland hvitløk, olje og smør i en gryte og varm opp til det bobler. Hell smørblandingen over brødterningene, la dem trekke til seg smøret, og stek dem deretter gyldne i en stekepanne. Legg salatbladene i en bolle, tilsett krutongene, og hell over dressingen før servering.","faqs":[{"question":"Hvordan kan jeg gjøre Cæsarsalaten sunnere uten å miste smaken?","answer":"Bytt ut loff med fullkornsbrød for mer fiber, og reduser mengden smør ved å bruke mer olivenolje i stedet. Du kan også bruke mindre parmesan eller erstatte med en lettere ost.","type":"health","score":5},{"question":"Er det noen allergihensyn knyttet til melk i denne cæsarsalaten?","answer":"Ja, cæsarsalaten inneholder meierismør og parmesanost, som begge er melkeprodukter.","type":"allergy","score":4},{"question":"Hvorfor blir ikke krutongene mine sprø når jeg steker dem?","answer":"Sørg for at brødterningene trekker til seg nok av smørblandingen før steking, og stek dem i en varm panne til de er gyldne. Unngå å overfylle pannen for å sikre jevn steking.","type":"technique","score":5}],"micro_answers":["Oppbevaring: Salaten bør serveres umiddelbart etter tilberedning.","Tilberedningsmetode: Krutonger stekes gyldne i stekepanne.","Metode: stekt.","Allergener: melk, egg.","Nøkkelingredienser: 2 stk romanosalat, 20 g rød lollo salat, 20 g rødbetespirer."],"metadata":{"ingredients":["2 stk romanosalat","20 g rød lollo salat","20 g rødbetespirer","4 båt hvitløk, presset","1 dl olivenolje","150 g meierismør","2 stk loff, i terninger","2 stk eggeplomme","3 båt hvitløk, hakket","1 ss dijonsennep","1 stk sitron, saften","2 dl virgin olivenolje","1 ts worchestershiresaus","3 stk ansjosfileter","1 dl parmesaneller godt lagret edamerost"],"category":null,"cooking_method":"stekt","allergens":["melk","egg"],"signals":{"has_milk":false,"has_egg":true,"is_fried":true,"is_baked":false,"is_sweet":false}}},{"recipe":"Avokadosalat med kyllingbryst","primary_answer":"Del paprika i båter og bak i ovn på 200 °C i 5 minutter. Stek kyllingbrystene i 5 minutter på hver side, og del dem opp. La paprika og kyllingbryst avkjøles litt før de legges på toppen av salaten, sammen med avokadoen.","faqs":[{"question":"Hvordan bør avokadosalaten med kyllingbryst oppbevares etter tilberedning?","answer":"Oppbevar avokadosalaten i en lufttett beholder i kjøleskapet, og sørg for at kyllingbrystene er avkjølt før de legges sammen med salaten for å unngå at den blir vassen. Konsumer innen 1-2 dager for best smak og kvalitet.","type":"storage","score":5},{"question":"Hvorfor blir ikke paprikaen myk etter ovnsbaking?","answer":"Sørg for at ovnen er forvarmet til 200 °C og at paprikaen er delt i jevne båter for jevn varmefordeling.","type":"technique","score":4}],"micro_answers":["Oppbevaring: Avkjøl kylling og paprika før servering.","Tilberedningsmetode: Ovnsbakt paprika og stekt kylling.","Ingrediens: Inneholder avokado og kvarg.","Tilberedning: Bak paprika i ovn på 200 °C."],"metadata":{"ingredients":["1 stk gul paprika","1 stk rød paprika","200 g grønn lollo salat","200 g ekebladsalat","150 g friséesalat","10 blad frisk basilikum","1 stk avokado","2 stk kyllingbryst","1 dl fruktjuice","2 dl kvarg naturell (f.eks kesam)"],"category":"Salater","cooking_method":"ovnsbakt","allergens":[],"signals":{"has_milk":false,"has_egg":false,"is_fried":false,"is_baked":true,"is_sweet":false}}},{"recipe":"Strull","primary_answer":"Visp sammen fløte og sukker, og rør inn hvetemel, kardemomme og vann. La røren svelle i ca. 30 minutter før du legger en stor teskje røre på krumkakejern og steker løvtynne strull. Rull dem straks rundt en pinne rett fra jernet.","faqs":[{"question":"Hvordan bør strull oppbevares etter steking for å bevare sprøheten?","answer":"Etter steking bør strull avkjøles på rist og deretter oppbevares i en tett boks eller i fryseboksen for å bevare sprøheten.","type":"storage","score":5},{"question":"Kan jeg bytte ut rømme eller fløte i strull-oppskriften?","answer":"Ja, du kan bruke en kombinasjon av rømme og fløte, eller velge én av dem. Husk at fettinnholdet påvirker smaken og konsistensen, så velg produkter med 35-39 % fett for best resultat.","type":"substitution","score":5},{"question":"Er det noen allergihensyn knyttet til melk i denne strulloppskriften?","answer":"Ja, oppskriften inneholder rømme eller fløte som begge er melkeprodukter.","type":"allergy","score":4},{"question":"Hvorfor blir strullene mine ikke knasende sprø etter steking?","answer":"Sørg for at røren er tynn nok før steking, da dette gir de løvtynne og sprø kakene. Hvis strullene ikke blir sprø, kan det hjelpe å justere mengden vann i røren eller å steke dem litt lenger.","type":"technique","score":5}],"micro_answers":["Tilberedningsmetode: stekt.","Ingredienser inkluderer rømme og hvetemel.","Metode: stekt.","Kategori: Smaakaker.","Allergener: melk, gluten."],"metadata":{"ingredients":["3 dl rømme (35 -39 % fett)eller fløte (eller en kombinasjon av disse)","100 g sukker","120 g hvetemel","0.5 ts malt kardemomme","0.5 dl vann"],"category":"Smaakaker","cooking_method":"stekt","allergens":["melk","gluten"],"signals":{"has_milk":true,"has_egg":false,"is_fried":true,"is_baked":false,"is_sweet":true}}},{"recipe":"Berlinerkranser","primary_answer":"Mos den hardkokte eggeplommen i den rå eggeplommen og pisk med sukker til en luftig eggedosis. Form deigen til kranser, dypp i eggehvite og perlesukker, og ovnsbak dem på 180 °C i ca 10 minutter.","faqs":[{"question":"Hvordan bør berlinerkransene oppbevares etter tilberedning?","answer":"Oppbevar berlinerkransene i en lufttett boks ved romtemperatur for å bevare sprøheten. Unngå fuktige omgivelser, da perlesukkeret kan smelte.","type":"storage","score":5},{"question":"Kan jeg bytte ut eggeplommene i denne berlinerkransoppskriften?","answer":"Eggeplommene gir berlinerkransene deres karakteristiske tekstur og smak, så det er vanskelig å erstatte dem uten å påvirke resultatet. Du kan prøve med en eggerstatning, men vær oppmerksom på at det kan endre både smak og konsistens.","type":"substitution","score":3},{"question":"Er det noen allergihensyn knyttet til gluten i denne berlinerkransoppskriften?","answer":"Ja, oppskriften inneholder hvetemel som er en kilde til gluten. For glutenfri alternativer, kan du prøve å erstatte hvetemelet med et glutenfritt mel.","type":"allergy","score":4},{"question":"Hvorfor blir berlinerkransene mine flate under steking?","answer":"Sørg for at deigen er godt avkjølt før du former kransene. Hvis smøret i deigen er for varmt, kan kransene miste formen under steking.","type":"technique","score":5}],"micro_answers":["Oppbevaring: Kjølig i et par timer før baking.","Tilberedningsmetode: Ovnsbakt ved 180 °C.","Ingrediens: 1 stk Eggeplomme brukes to ganger."],"metadata":{"ingredients":["1 stk eggeplomme","1 stk eggeplomme","60 g sukker","125 g smør","175 g hvetemel","1 stk eggehvite","1 dl perlesukker"],"category":"Smaakaker","cooking_method":"ovnsbakt","allergens":["melk","egg","gluten"],"signals":{"has_milk":true,"has_egg":true,"is_fried":false,"is_baked":true,"is_sweet":true}}},{"recipe":"Rød fiskesuppe","primary_answer":"Fres løk, hvitløk, gulrot og selleri i smør før du tilsetter vann, melk og tomater. La suppen koke på svak varme i 5 minutter, tilsett deretter laksebitene og la dem trekke i ytterligere 5 minutter.","faqs":[{"question":"Hvordan bør rød fiskesuppe oppbevares etter tilberedning?","answer":"Etter tilberedning bør rød fiskesuppe avkjøles raskt og oppbevares i en lufttett beholder i kjøleskapet. På grunn av ingredienser som laksefilet og lettmelk, bør den spises innen 2 dager.","type":"storage","score":5},{"question":"Hvordan kan jeg gjøre rød fiskesuppe litt sunnere uten å miste karakteren sin?","answer":"Bytt ut smøret med olivenolje for en sunnere fettkilde, og bruk skummet melk i stedet for lettmelk for å redusere fettinnholdet ytterligere.","type":"health","score":5},{"question":"Kan jeg bytte ut lettmelken i denne røde fiskesuppen?","answer":"Ja, du kan bytte ut lettmelken med en plantebasert melk som havremelk for en laktosefri variant, men det kan påvirke smaken og konsistensen litt.","type":"substitution","score":5},{"question":"Er det noen allergihensyn knyttet til melk i denne røde fiskesuppen?","answer":"Ja, suppen inneholder lettmelk og crème fraîche, som begge er melkeprodukter. Hvis du har melkeallergi, bør du vurdere alternativer som plantebasert melk og crème fraîche-erstatninger.","type":"allergy","score":4}],"micro_answers":["Oppbevaring: Oppbevar suppen i kjøleskap, maks 2 dager.","Tilberedningsmetode: Suppen er kokt.","Ingrediens: Bruk 4 dl lettmelk i suppen."],"metadata":{"ingredients":["1 bunt vårløk","1 stk løk","1 båt hvitløk","2 stk gulrot","0.5 stk knollselleri (sellerirot)","2 ss smør","4 dl vann","4 dl lettmelk (0,5 % fett)","1 boks hermetiske tomater","200 g laksefilet","0.5 ts salt","0.5 ts pepper","0.5 stk sitron(saft)","4 ss crème fraîche lett, 18 %","8 blad frisk koriander"],"category":"Supper","cooking_method":"kokt","allergens":["melk","gluten"],"signals":{"has_milk":true,"has_egg":false,"is_fried":false,"is_baked":false,"is_sweet":false}}},{"recipe":"Bergensk fiskesuppe","primary_answer":"For å lage Bergensk fiskesuppe, skrell og del gulrot, løk, purre og selleri i biter, og kok dem med pepperkorn i vann for å lage kraften. Når kraften er ferdig, sil den og tilsett grønnsaker og fløte, og la det koke opp før du tilsetter fiskeboller og fiskebiter. Suppen serveres med reker og ferskt brød.","faqs":[{"question":"Hvordan kan jeg redusere fettinnholdet i Bergensk fiskesuppe uten å miste smaken?","answer":"Du kan erstatte kremfløten med matfløte eller melk for å redusere fettinnholdet, og bruke lett rømme i stedet for vanlig rømme.","type":"health","score":5},{"question":"Kan jeg bytte ut melken i denne bergenske fiskesuppen?","answer":"Ja, du kan bytte ut melken med en plantebasert melk som havremelk eller mandelmelk. Dette kan påvirke smaken litt, men vil fortsatt gi en jevn og luftig fiskefarse.","type":"substitution","score":5},{"question":"Hvorfor blir fiskebollene mine for harde i Bergensk fiskesuppe?","answer":"Fiskebollene kan bli harde hvis du ikke spe fiskefarsen med nok melk, eller hvis du koker dem for lenge. Sørg for å spe til du har en jevn luftig masse og la dem trekke i lettsaltet vann i ca. 5 minutter.","type":"technique","score":4}],"micro_answers":["Oppbevaring: Kjøleskap, maks 3 dager.","Allergener: Inneholder melk og gluten.","Tilberedningsmetode: Ovnsbakt.","Ingrediens: 400 g Torskefilet.","Tilberedning: Kok opp kraft og tilsett grønnsaker."],"metadata":{"ingredients":["1 stk gulrot","0.5 stk løk","0.25 stk stilkselleri (stangselleri)","1 stk purre","10 stk hel pepper","1.5 l vann","0.5 ts salt","400 g torskefilet","1 ss potetmel","1 ts salt","2 dl melk","4 stk gulrot","0.5 stk knollselleri (sellerirot)","2 stk purre","3 dl kremfløte","1 ss eddik, 7 %","3 dl rømme (35 -39 % fett)","3 ss hvetemel","100 g reker"],"category":"Supper","cooking_method":"ovnsbakt","allergens":["melk","gluten"],"signals":{"has_milk":true,"has_egg":false,"is_fried":false,"is_baked":true,"is_sweet":false}}},{"recipe":"Bruschetta","primary_answer":"Del baguetten i to på langs og smør på en blanding av lettrømme og finhakket hvitløk. Legg på oppskåret tomat, rødløk, pastrami og mozzarella, og dryss over vellagret ost. Ovnsbak bruschettaene på 230 °C i ca 10 minutter til osten er gyllen.","faqs":[{"question":"Hvordan kan jeg gjøre bruschettaen litt sunnere uten å miste smaken?","answer":"Bytt ut lettrømme med gresk yoghurt for en lettere dressing, og bruk fullkornsbaguette for mer fiber. Reduser mengden ost litt og legg til flere tomater for ekstra friskhet.","type":"health","score":5},{"question":"Kan jeg bytte ut lettrømmen i denne bruschettaoppskriften?","answer":"Ja, du kan bytte ut lettrømmen med crème fraîche for en litt fyldigere smak, eller med gresk yoghurt for en lettere variant. Begge alternativene vil fungere godt med hvitløksdressingen.","type":"substitution","score":5},{"question":"Er det melk i ingrediensene til denne bruschettaen?","answer":"Ja, både lettrømme, mozzarella og vellagret ost inneholder melk.","type":"allergy","score":4},{"question":"Hvorfor blir ikke osten gyllen og fin på bruschettaen?","answer":"Sørg for at ovnen er forvarmet til 230 °C og at bruschettaene er plassert på øverste rille. Dette sikrer at osten smelter og får en gyllen farge.","type":"technique","score":4}],"micro_answers":["Oppbevaring: Bruschetta bør serveres umiddelbart etter tilberedning.","Tilberedningsmetode: Ovnsbakt ved 230 °C i 10 minutter.","Ingrediens: Inneholder pastrami og mozzarella."],"metadata":{"ingredients":["1 stk baguette","2 dl lettrømme","1 båt hvitløk,finhakket","4 ss pestomed hvitløk","2 stk tomat","0.5 stk rødløk","200 g pastramii skiver","200 g mozzarella","5 ss vellagret ost"],"category":null,"cooking_method":"ovnsbakt","allergens":["melk"],"signals":{"has_milk":true,"has_egg":false,"is_fried":false,"is_baked":true,"is_sweet":false}}},{"recipe":"Appelsin- og hvitløksmarinert ost","primary_answer":"Skjær gulosten i terninger og legg den lagvis med valnøttkjerner, hvitløk og appelsinskall i en krukke. Hell over olivenolje og bland godt, før du lar det trekke på et kjølig sted i minst 1 døgn.","faqs":[{"question":"Hvordan bør appelsin- og hvitløksmarinert ost oppbevares etter tilberedning?","answer":"Oppbevar den marinert osten i en tett krukke i kjøleskapet. Sørg for at osten er dekket av olivenolje for å bevare smaken og forhindre at den tørker ut.","type":"storage","score":5},{"question":"Hvordan kan jeg gjøre appelsin- og hvitløksmarinert ost litt sunnere uten å miste karakteren sin?","answer":"Bytt ut halvparten av olivenoljen med en lett olivenoljevariant, og bruk en mindre mengde ost med redusert fettinnhold for å beholde smaken samtidig som du reduserer fettinnholdet.","type":"health","score":5},{"question":"Er det nøtter i denne appelsin- og hvitløksmarinerte osten?","answer":"Ja, oppskriften inneholder valnøttkjerner, så den er ikke egnet for personer med nøtteallergi.","type":"allergy","score":4}],"micro_answers":["Oppbevaring: Kjølig sted i minst 1 døgn.","Ingrediens: 100 g Gulost, 50 g Valnøttkjerner.","Metode: blandet.","Kategori: Tapas.","Allergener: melk, nøtter."],"metadata":{"ingredients":["100 g gulost","50 g valnøttkjerner","3 båt hvitløk","1 stk appelsin","2 ss frisk timian","0.25 ts salt","2 dl olivenolje"],"category":"Tapas","cooking_method":"blandet","allergens":["melk","nøtter"],"signals":{"has_milk":false,"has_egg":false,"is_fried":false,"is_baked":false,"is_sweet":false}}},{"recipe":"Avokadokrem","primary_answer":"Mos de modne avokadoene og press et hvitløksfedd. Bland avokado og hvitløk inn i kvargen. Smak til med chiliflakes, limesaft, salt og nykvernet pepper.","faqs":[{"question":"Hvordan bør avokadokremen oppbevares etter tilberedning?","answer":"Oppbevar avokadokremen i en lufttett beholder i kjøleskapet for å forhindre at avokadoen oksiderer og blir brun. Sørg for at kremen er dekket godt, gjerne med plastfolie direkte på overflaten, for å bevare smaken fra hvitløk og lime.","type":"storage","score":4},{"question":"Inneholder avokadokremen melk?","answer":"Ja, avokadokremen inneholder kvarg, som er en melkeprodukt.","type":"allergy","score":4}],"micro_answers":["Oppbevaring: Avokadokrem bør oppbevares kjølig, i tett beholder.","Allergen: Inneholder melk fra kvarg.","Tips: Smak til med lime og chiliflakes for ekstra friskhet."],"metadata":{"ingredients":["2 stk avokado(most)","1 båt hvitløk(presset)","salt og nykvernet pepper","1 dl kvarg naturell (f.eks kesam)","chiliflakes og lime"],"category":"Tilbehoer","cooking_method":"blandet","allergens":["melk"],"signals":{"has_milk":false,"has_egg":false,"is_fried":false,"is_baked":false,"is_sweet":false}}},{"recipe":"Avokadodipp med chili og koriander","primary_answer":"Mos en moden avokado med en gaffel og bland den med finhakket hvitløk, grønn chili, limesaft og salt. Tilsett matyoghurt og rør alt sammen før du smaker til med hakket koriander.","faqs":[{"question":"Hvordan bør avokadodippen med chili og koriander oppbevares etter tilberedning?","answer":"Oppbevar avokadodippen i en lufttett beholder i kjøleskapet for å bevare friskheten. For å unngå misfarging, kan du dekke overflaten med plastfolie før du setter på lokket.","type":"storage","score":5},{"question":"Hvordan kan jeg gjøre avokadodippen med chili og koriander litt sunnere uten å miste karakteren sin?","answer":"Du kan bruke gresk yoghurt med lavere fettinnhold i stedet for vanlig matyoghurt for å redusere kaloriene, og fortsatt beholde den kremete konsistensen.","type":"health","score":5},{"question":"Inneholder avokadodippen melk?","answer":"Ja, avokadodippen inneholder matyoghurt, som er laget av melk.","type":"allergy","score":4}],"micro_answers":["Oppbevaring: Avokadodipp bør oppbevares kjølig og lufttett.","Allergen: Inneholder melk fra matyoghurt.","Ingrediens: Inneholder frisk koriander og grønn chili."],"metadata":{"ingredients":["1.5 dl matyoghurt","1 stk avokado","5 g grønn chili","1 ss limesaft","1 båt hvitløk","0.5 ts salt","5 g frisk koriander"],"category":"Tilbehoer","cooking_method":"blandet","allergens":["melk"],"signals":{"has_milk":false,"has_egg":false,"is_fried":false,"is_baked":false,"is_sweet":false}}},{"recipe":"Soll","primary_answer":"Knus flatbrød eller knekkebrød og hakk hasselnøtter. Bland dette med syrnet melk som kefir, og servér gjerne med litt syltetøy.","faqs":[{"question":"Hvordan kan jeg gjøre soll-oppskriften litt sunnere uten å miste smaken?","answer":"Bytt ut flatbrød eller knekkebrød med en fullkornsvariant, og bruk usaltede hasselnøtter for å redusere saltinnholdet.","type":"health","score":5},{"question":"Kan jeg bytte ut syrnet melk i soll-oppskriften?","answer":"Ja, du kan bytte ut syrnet melk med tjukkmjølk for en lignende smak og konsistens.","type":"substitution","score":5},{"question":"Er det gluten i soll-oppskriften?","answer":"Ja, oppskriften inneholder flatbrød eller knekkebrød som kan inneholde gluten.","type":"allergy","score":4}],"micro_answers":["Oppbevaring: Kjølig og tørt sted.","Allergener: Inneholder melk, gluten og nøtter.","Ingrediens: 5 dl syrnet melk som kefir."],"metadata":{"ingredients":["6 stk flatbrødeller knekkebrød","0.5 dl hasselnøtter","5 dl syrnet melk (f. eks. kefir)eller tjukkmjølk"],"category":null,"cooking_method":"blandet","allergens":["melk","gluten","nøtter"],"signals":{"has_milk":true,"has_egg":false,"is_fried":false,"is_baked":false,"is_sweet":false}}},{"recipe":"Aslaugs gomme","primary_answer":"Kok opp helmelken og smelt geitosten i den varme melken. Rør inn syrnet melk og la det koke i 2 timer til væsken fordamper og gommen blir tykkere. Tilsett semulegrynsblandingen og smak til med malt anis før avkjøling.","faqs":[{"question":"Hvordan bør Aslaugs gomme oppbevares etter tilberedning?","answer":"Etter tilberedning bør Aslaugs gomme avkjøles helt og deretter oppbevares i en lufttett beholder i kjøleskapet. Dette vil bevare smaken fra geitosten og den syrlige melken.","type":"storage","score":5},{"question":"Hvordan kan jeg gjøre Aslaugs gomme litt sunnere uten å miste karakteren sin?","answer":"Bytt ut helmelk med lettmelk for å redusere fettinnholdet, og bruk mindre rosiner for å redusere sukkerinnholdet, samtidig som du beholder den tradisjonelle smaken.","type":"health","score":5},{"question":"Kan jeg bytte ut helmelk i Aslaugs gomme?","answer":"Ja, du kan bruke lettmelk i stedet for helmelk, men det kan påvirke den kremete konsistensen og smaken av gommen.","type":"substitution","score":5},{"question":"Er det melk i Aslaugs gomme?","answer":"Ja, oppskriften inneholder helmelk, syrnet melk og lettmelk.","type":"allergy","score":4}],"micro_answers":["Oppbevaring: Kald gomme i kjøleskap.","Allergener: Inneholder melk og gluten.","Tilberedningsmetode: Gomme kokes til tykk konsistens.","Ingrediens: Ekte geitost gir unik smak.","Servering: Kald gomme med rosiner."],"metadata":{"ingredients":["1 l helmelk","100 g ekte geitost","2 dl syrnet melk","2 ss semulegryn","0.5 dl lettmelk","1 ts malt anis","1 dl rosiner"],"category":"Tradisjonsmelkeretter","cooking_method":"kokt","allergens":["melk","gluten"],"signals":{"has_milk":true,"has_egg":false,"is_fried":false,"is_baked":false,"is_sweet":false}}},{"recipe":"Vafler med rømme","primary_answer":"Bland alle ingrediensene, bortsett fra smør, til en jevn røre og la den svelle i minst ½ time. Smelt smøret, rør det inn, og stek vaflene til de er gylne.","faqs":[{"question":"Hvordan bør vafler med rømme oppbevares etter tilberedning?","answer":"Etter steking, la vaflene avkjøles helt før du legger dem i en lufttett beholder. På grunn av ingredienser som lettrømme og meierismør, bør de oppbevares i kjøleskapet og spises innen 2-3 dager.","type":"storage","score":5},{"question":"Hvordan kan jeg gjøre vafler med rømme litt sunnere uten å miste karakteren sin?","answer":"Du kan redusere mengden sukker eller bytte det ut med et naturlig søtningsmiddel som honning. Prøv også å bruke fullkornsmel i stedet for hvetemel for mer fiber.","type":"health","score":5},{"question":"Kan jeg bytte ut eggene i vafler med rømme?","answer":"Ja, du kan erstatte eggene med 1 ss linfrø blandet med 3 ss vann per egg, eller bruke en kommersiell eggerstatning for å oppnå lignende konsistens.","type":"substitution","score":5},{"question":"Er det gluten i vafler med rømme?","answer":"Ja, vafler med rømme inneholder hvetemel, som er en kilde til gluten.","type":"allergy","score":4},{"question":"Hvorfor blir vaflene mine seige i midten?","answer":"Vaflene kan bli seige hvis røren ikke har fått svelle lenge nok. Sørg for å la røren hvile i minst 30 minutter før steking for å få et bedre resultat.","type":"technique","score":5}],"micro_answers":["Oppbevaring: Vafler kan fryses for lengre holdbarhet.","Allergener: Inneholder melk, egg og gluten.","Tilberedningsmetode: Vaflene stekes til de er gylne."],"metadata":{"ingredients":["4 dl melk","2 dl lettrømme","4 stk egg","6 dl hvetemel","1 ss vaniljesukker","0.5 ts natron","1 dl sukker","0.5 ts salt","1 ts malt kardemomme","100 g meierismør"],"category":null,"cooking_method":"stekt","allergens":["melk","egg","gluten"],"signals":{"has_milk":true,"has_egg":true,"is_fried":true,"is_baked":false,"is_sweet":true}}},{"recipe":"Bananvafler","primary_answer":"Mos bananene godt og bland dem med havremel, bakepulver, kardemomme, kanel og salt. Rør inn yoghurt og egg, og tilsett melk etter behov. La røren svelle i 30 minutter før du steker vaflene til de er gyldne.","faqs":[{"question":"Hvordan bør bananvafler oppbevares etter tilberedning?","answer":"Etter tilberedning bør bananvaflene avkjøles helt og deretter oppbevares i en lufttett beholder i kjøleskapet. Dette forhindrer at de blir tørre og bevarer smaken fra banan og krydder.","type":"storage","score":5},{"question":"Hvordan kan jeg redusere kaloriinnholdet i bananvaflene uten å endre smaken for mye?","answer":"Du kan bruke lett yoghurt i stedet for vanlig yoghurt naturell, og erstatte en del av melken med vann for å redusere kaloriinnholdet uten å påvirke smaken nevneverdig.","type":"health","score":5},{"question":"Kan jeg bytte ut melken i bananvaflene med en plantebasert melk?","answer":"Ja, du kan bytte ut melken med en plantebasert melk som mandel- eller havremelk. Dette kan påvirke smaken litt, men vaflene vil fortsatt bli gode.","type":"substitution","score":5},{"question":"Er det melk i bananvaflene?","answer":"Ja, oppskriften inneholder 3.5 dl melk og 250 g yoghurt naturell.","type":"allergy","score":4},{"question":"Hvorfor blir bananvaflene mine ikke sprø?","answer":"For å få sprø bananvafler, sørg for at vaffeljernet er godt oppvarmet før du begynner å steke, og unngå å bruke for mye melk i røren, da dette kan gjøre dem myke.","type":"technique","score":5}],"micro_answers":["Oppbevaring: Oppbevar vafler i kjøleskap for friskhet.","Allergener: Inneholder melk, egg og gluten.","Tilberedningsmetode: Stekt til gyldne.","Ingrediens: Banan gir naturlig sødme."],"metadata":{"ingredients":["2 stk banan","5 dl havremel","1 ts bakepulver","1 ts malt kardemomme","1 ss malt kanel","0.5 ts salt","4 stk egg","250 g yoghurt naturell","3.5 dl melk"],"category":"Vafler","cooking_method":"stekt","allergens":["melk","egg","gluten"],"signals":{"has_milk":true,"has_egg":true,"is_fried":true,"is_baked":false,"is_sweet":true}}},{"recipe":"Havanna","primary_answer":"Start med å helle varm espresso i et høyt glass, og bland deretter inn 2 ts lys sirup og 3 dråper romessens. Topp med varm melk og melkeskum for en fyldig avslutning.","faqs":[{"question":"Kan jeg bytte ut lettmelken i Havanna-oppskriften med et annet meieriprodukt?","answer":"Ja, du kan bytte ut lettmelken med helmelk for en fyldigere smak, men det kan påvirke skummengden. Sørg for å varme og skumme melken på samme måte.","type":"substitution","score":5},{"question":"Inneholder Havanna-oppskriften melk?","answer":"Ja, Havanna-oppskriften inneholder 3 dl lettmelk som en av hovedingrediensene.","type":"allergy","score":4}],"micro_answers":["Oppbevaring: Serveres umiddelbart etter tilberedning.","Tilberedningsmetode: Drikken er blandet.","Ingredienser: Espresso, sirup, romessens, lettmelk."],"metadata":{"ingredients":["2 dl espressokaffe","2 ts lys sirup","3 dråpe romessens(eller 1 ss mørk rom)","3 dl lettmelk"],"category":"Varme drikker","cooking_method":"blandet","allergens":["melk","gluten"],"signals":{"has_milk":true,"has_egg":false,"is_fried":false,"is_baked":false,"is_sweet":true}}},{"recipe":"Cappuccino","primary_answer":"Kjør 2 dl skummet melk til skum i en steamer og bland med 2 dl espressokaffe. Dryss 0.5 ss malt kanel på toppen før servering.","faqs":[{"question":"Hvordan bør cappuccinoen oppbevares etter tilberedning?","answer":"Cappuccinoen bør nytes umiddelbart etter tilberedning for best smak og konsistens, da melkeskummet kan miste sin tekstur ved oppbevaring.","type":"storage","score":5},{"question":"Hvordan kan jeg gjøre cappuccinoen litt sunnere uten å miste smaken?","answer":"Bytt ut skummet melk med en usøtet mandel- eller havremelk for færre kalorier, og bruk kanel som søtningsmiddel i stedet for sukker.","type":"health","score":5},{"question":"Kan jeg bytte ut skummet melk i cappuccinoen med et annet meieriprodukt?","answer":"Ja, du kan bruke helmelk eller lettmelk for en rikere smak, men det kan påvirke skumkvaliteten. Prøv også havremelk for et laktosefritt alternativ.","type":"substitution","score":5},{"question":"Er det noen allergihensyn for melk i denne cappuccino-oppskriften?","answer":"Ja, oppskriften inneholder skummet melk, så den er ikke egnet for personer med melkeallergi.","type":"allergy","score":4}],"micro_answers":["Oppbevaring: Serveres umiddelbart etter tilberedning.","Allergener: Inneholder melk og gluten.","Tilberedningsmetode: Melk skummes og blandes med espresso.","Ingrediens: 2 dl Skummet melk."],"metadata":{"ingredients":["2 dl skummet melk","2 dl espressokaffe","0.5 ss malt kanel"],"category":"Varme drikker","cooking_method":"blandet","allergens":["melk","gluten"],"signals":{"has_milk":true,"has_egg":false,"is_fried":false,"is_baked":false,"is_sweet":true}}},{"recipe":"Wraps med laks","primary_answer":"Bland hvetemel, byggmel, bakepulver, salt og vann til en smidig deig, og la den hvile. Kjevle ut deigen til runde leiver og stek dem i en tørr stekepanne til de blåser seg opp. Fyll de stekte lefsene med cottage cheese, røkelaks, hjertesalat og avokado, og rull sammen.","faqs":[{"question":"Hvordan bør wraps med laks oppbevares etter tilberedning?","answer":"Wraps med laks bør oppbevares i en lufttett beholder i kjøleskapet for å holde røkelaksen og avokadoen fersk. Konsumer innen 1-2 dager for best smak.","type":"storage","score":5},{"question":"Hvordan kan jeg gjøre wraps med laks litt sunnere uten å miste karakteren sin?","answer":"Bytt ut solsikkeoljen med olivenolje for sunnere fett, og bruk fullkornshvetemel i stedet for vanlig hvetemel for mer fiber.","type":"health","score":5},{"question":"Er det gluten i wraps med laks-oppskriften?","answer":"Ja, oppskriften inneholder gluten fra både hvetemel og byggmel som brukes i tortilladeigen.","type":"allergy","score":5},{"question":"Hvorfor blir ikke lefsene mine myke når jeg steker dem?","answer":"Pass på at stekepannen er varm nok før du legger i lefsene, og ikke stek dem for lenge. Hvis lefsene blir for tørre, kan det hjelpe å dekke dem med et fuktig kjøkkenhåndkle etter steking.","type":"technique","score":5}],"micro_answers":["Oppbevaring: Wraps bør oppbevares kjølig for friskhet.","Allergener: Inneholder gluten fra hvetemel.","Tilberedningsmetode: Stek lefsene i tørr stekepanne.","Ingrediens: Bruk 6 skiver røkelaks til fyll.","Ingrediens: 60 g byggmel i deigen."],"metadata":{"ingredients":["2 ss solsikkeolje","1 ts bakepulver","60 g byggmel","120 g hvetemel","0.25 ts salt","1 dl vann","3 dl cottage cheese","6 skive røkelaks","6 blad hjertesalat","1 stk avokado"],"category":null,"cooking_method":"stekt","allergens":["gluten"],"signals":{"has_milk":false,"has_egg":false,"is_fried":true,"is_baked":false,"is_sweet":false}}},{"recipe":"Laksewraps med mangochutneydressing","primary_answer":"Del laksen i mindre biter, vend dem i mel, egg og kavring, og stek dem deretter i litt olje på middels sterk varme. Fyll hjertesalatblader med de stekte laksebitene, rødløk, avokado og mangochutneydressing for en smakfull wrap.","faqs":[{"question":"Hvordan bør laksewraps med mangochutneydressing oppbevares etter tilberedning?","answer":"Oppbevar laksewrapsene i en lufttett beholder i kjøleskapet, og sørg for at de er avkjølt før lagring. Dette vil bevare friskheten i ingrediensene som avokado og hjertesalat, og holde stekt laks saftig.","type":"storage","score":5},{"question":"Hvordan kan jeg gjøre laksewraps med mangochutneydressing litt sunnere uten å miste karakteren sin?","answer":"Bytt ut lettrømme med ekstra yoghurt naturell for mindre fett, og bruk fullkornskavring i stedet for vanlig kavring for mer fiber.","type":"health","score":5},{"question":"Kan jeg bytte ut eggene i laksewraps med mangochutneydressing?","answer":"Ja, du kan bruke en blanding av 2 ss vann og 1 ss linfrømel som erstatning for eggene når du panerer laksen.","type":"substitution","score":5},{"question":"Er det melk i laksewraps med mangochutneydressing?","answer":"Ja, oppskriften inneholder både lettrømme og yoghurt naturell, som begge er melkeprodukter.","type":"allergy","score":4},{"question":"Hvorfor blir ikke laksebitene sprø når jeg steker dem?","answer":"Sørg for at oljen er varm nok før du legger i laksebitene, og at de er godt dekket med kavringblandingen. Stek dem på middels sterk varme for å oppnå en sprø overflate.","type":"technique","score":5}],"micro_answers":["Oppbevaring: Oppbevar laksewraps i kjøleskap i opptil 2 dager.","Allergener: Inneholder melk, egg og gluten.","Tilberedningsmetode: Laksebitene stekes i olje på middels varme.","Ingrediens: Mangochutney gir dressingen en søt og krydret smak."],"metadata":{"ingredients":["1 dl lettrømme","1 dl yoghurt naturell","2 ss mangochutney","0.5 stk slangeagurk","2 stk avokado","0.5 stk rødløk","50 g kavring","1 ts paprikapulver","50 g hvetemel","2 stk egg","400 g laksefilet","2 stk hjertesalat"],"category":"Wraps","cooking_method":"stekt","allergens":["melk","egg","gluten"],"signals":{"has_milk":true,"has_egg":true,"is_fried":true,"is_baked":false,"is_sweet":false}}}]}]]}]}],["$L6"],"$L7"]}],{},null,false,null]},null,false,"$@8"]},null,false,null],"$L9",false]],"m":"$undefined","G":["$a",["$Lb"]],"S":true,"h":null,"s":"$undefined","l":"$undefined","p":"$undefined","d":"$undefined","b":"pSnFcpyhvEJW3h93nsfuz"}
